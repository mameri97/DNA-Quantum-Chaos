Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"pGOE", "[", "s_", "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"Pi", "/", "2"}], ")"}], "*", "s", "*", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "Pi"}], "*", 
       RowBox[{
        RowBox[{"s", "^", "2"}], "/", "4"}]}], "]"}]}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"OccupiedPlot", "=", 
    RowBox[{"Show", "[", 
     RowBox[{
      RowBox[{"Histogram", "[", 
       RowBox[{"AllOccupiedSpacings", ",", 
        RowBox[{"{", "0.05", "}"}], ",", "\"\<PDF\>\"", ",", 
        RowBox[{"ChartStyle", "\[Rule]", 
         RowBox[{"Directive", "[", 
          RowBox[{"Blue", ",", 
           RowBox[{"Opacity", "[", "0.6", "]"}]}], "]"}]}]}], "]"}], ",", 
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"pGOE", "[", "s", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "0", ",", "3.5"}], "}"}], ",", 
