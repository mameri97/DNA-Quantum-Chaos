Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "2.", " ", "DEFINE", " ", "FUNCTION", " ", "TO", " ", "COMPUTE", " ", 
     "r"}], "-", 
    RowBox[{"VALUES", " ", "FOR", " ", "A", " ", "SINGLE", " ", "FILE"}]}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ProcessSingleFileForR", "[", "filePath_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "importedData", ",", "rawEnergies", ",", "sortedLevels", ",", 
        "rawSpacings", ",", "rValues"}], "}"}], ",", 
      RowBox[{"(*", 
       RowBox[{
       "Import", " ", "CSV", " ", "as", " ", "raw", " ", "Data", " ", 
        "table"}], "*)"}], 
      RowBox[{
       RowBox[{"importedData", "=", 
        RowBox[{"Import", "[", 
         RowBox[{"filePath", ",", "\"\<Data\>\""}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "importedData", "]"}], "\[LessEqual]", "1"}],
          ",", 
         RowBox[{"Return", "[", 
          RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Extract", " ", "column", " ", "4", " ", 
         RowBox[{"(", "\"\<orbital_energy_hartree\>\"", ")"}], " ", "and", 
         " ", "clean"}], "*)"}], 
       RowBox[{"rawEnergies", "=", 
        RowBox[{"ToExpression", "[", 
         RowBox[{
          RowBox[{"Rest", "[", "importedData", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "4"}], "]"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sortedLevels", "=", 
        RowBox[{"Sort", "[", 
         RowBox[{"N", "[", 
          RowBox[{"DeleteCases", "[", 
           RowBox[{"rawEnergies", ",", 
            RowBox[{
            "_Missing", "|", "Null", "|", "\"\<\>\"", "|", "_String"}]}], 
           "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "sortedLevels", "]"}], "<", "10"}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"{", "}"}], "]"}]}], "]"}], ";", 
       RowBox[{"(*", 
        RowBox[{
        "Skip", " ", "files", " ", "with", " ", "too", " ", "few", " ", 
         "levels"}], "*)"}], 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "Compute", " ", "consecutive", " ", "raw", " ", "spacings", " ", 
          "s_i"}], "=", 
         RowBox[{
          RowBox[{"E_", 
           RowBox[{"{", 
            RowBox[{"i", "+", "1"}], "}"}]}], "-", "E_i"}]}], "*)"}], 
       RowBox[{"rawSpacings", "=", 
        RowBox[{"Differences", "[", "sortedLevels", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "rawSpacings", "]"}], "<", "2"}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
          RowBox[{"Compute", " ", "adjacent"}], "-", 
          RowBox[{"gap", " ", "ratios", " ", "r_i"}]}], "=", 
         RowBox[{"Min", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"s_i", ",", 
             RowBox[{"s_", 
              RowBox[{"{", 
               RowBox[{"i", "+", "1"}], "}"}]}]}], ")"}], "/", "Max"}], 
          RowBox[{"(", 
           RowBox[{"s_i", ",", 
            RowBox[{"s_", 
             RowBox[{"{", 
              RowBox[{"i", "+", "1"}], "}"}]}]}], ")"}]}]}], "*)"}], 
       RowBox[{"rValues", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Min", "[", 
            RowBox[{
             RowBox[{"rawSpacings", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", 
             RowBox[{"rawSpacings", "[", 
              RowBox[{"[", 
               RowBox[{"i", "+", "1"}], "]"}], "]"}]}], "]"}], "/", 
           RowBox[{"Max", "[", 
            RowBox[{
             RowBox[{"rawSpacings", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", 
             RowBox[{"rawSpacings", "[", 
              RowBox[{"[", 
               RowBox[{"i", "+", "1"}], "]"}], "]"}]}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{
             RowBox[{"Length", "[", "rawSpacings", "]"}], "-", "1"}]}], 
           "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", "rValues"}]}], 
     "]"}]}], ";"}]}]], "Input",
 CellLabel->"In[22]:=",ExpressionUUID->"816909fd-7b98-4b6d-81f3-b586b2229d4d"],

