Cell[BoxData[
 RowBox[{
  RowBox[{"getEnergies", "[", "file_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"data", ",", "energies"}], "}"}], ",", 
    RowBox[{
     RowBox[{"data", "=", 
      RowBox[{"Import", "[", 
       RowBox[{"file", ",", "\"\<CSV\>\""}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"energies", "=", 
      RowBox[{"Cases", "[", 
       RowBox[{
        RowBox[{"Rest", "[", "data", "]"}], ",", 
        RowBox[{
         RowBox[{"row_List", "/;", 
          RowBox[{
           RowBox[{"Length", "[", "row", "]"}], "\[GreaterEqual]", "2"}]}], 
         "\[RuleDelayed]", 
         RowBox[{"row", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"N", "[", 
      RowBox[{"Cases", "[", 
       RowBox[{"energies", ",", 
        RowBox[{"_", "?", "NumericQ"}]}], "]"}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{4.003214387149314*^9, 4.003214387153317*^9}},
 CellLabel->
  "In[872]:=",ExpressionUUID->"8cdb9989-d22e-4c57-985f-6b96696efc58"],

