  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"7.", " ", "ENSEMBLE", " ", "AVERAGING"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"numberVarianceEnsemble", "[", 
     RowBox[{"unfolded_List", ",", "Lvals_List", ",", "nStarts_Integer", ",", 
      RowBox[{"edgeTrim_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", "vals", "}"}], ",", 
        RowBox[{
         RowBox[{"vals", "=", 
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"numberVarianceOne", "[", 
               RowBox[{"#", ",", "ell", ",", "nStarts", ",", "edgeTrim"}], 
               "]"}], "&"}], "/@", "unfolded"}], ",", "NumericQ"}], "]"}]}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "vals", "]"}], "\[GreaterEqual]", "2"}], 
           ",", 
           RowBox[{"{", 
            RowBox[{"ell", ",", 
             RowBox[{"Mean", "[", "vals", "]"}], ",", 
             RowBox[{
              RowBox[{"StandardDeviation", "[", "vals", "]"}], "/", 
              RowBox[{"Sqrt", "[", 
               RowBox[{"Length", "[", "vals", "]"}], "]"}]}], ",", 
             RowBox[{"Length", "[", "vals", "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"ell", ",", "Indeterminate", ",", "Indeterminate", ",", 
             RowBox[{"Length", "[", "vals", "]"}]}], "}"}]}], "]"}]}]}], 
       "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"ell", ",", "Lvals"}], "}"}]}], "]"}]}], ";"}]}]], "Input",
 CellLabel->
  "In[1778]:=",ExpressionUUID->"056a3a0b-d1b7-4fcb-b7ce-cdd9b1cd8f8c"],

