Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"for", " ", "finite", " ", "L"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"sigmaPoisson", "[", 
        RowBox[{"L_", "?", "NumericQ"}], "]"}], ":=", "L"}], ";"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"sigmaSemiPoisson", "[", 
        RowBox[{"L_", "?", "NumericQ"}], "]"}], ":=", 
       RowBox[{
        RowBox[{"L", "/", "2"}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "4"}], " ", "L"}], "]"}]}], ")"}], "/", "8"}]}]}], 
      ";"}], "\n", 
     RowBox[{
      RowBox[{
       RowBox[{"sigmaGUE", "[", 
        RowBox[{"L_", "?", "NumericQ"}], "]"}], ":=", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Log", "[", 
            RowBox[{"2", " ", "Pi", " ", "L"}], "]"}], "+", "EulerGamma", "+",
            "1", "-", 
           RowBox[{"Cos", "[", 
            RowBox[{"2", " ", "Pi", " ", "L"}], "]"}], "-", 
           RowBox[{"CosIntegral", "[", 
            RowBox[{"2", " ", "Pi", " ", "L"}], "]"}]}], ")"}], "/", 
         RowBox[{"Pi", "^", "2"}]}], "+", 
        RowBox[{"L", " ", 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"2", " ", 
            RowBox[{
             RowBox[{"SinIntegral", "[", 
              RowBox[{"2", " ", "Pi", " ", "L"}], "]"}], "/", "Pi"}]}]}], 
          ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"sigmaGOE", "[", 
       RowBox[{"L_", "?", "NumericQ"}], "]"}], ":=", 
      RowBox[{
       RowBox[{"2", " ", 
        RowBox[{"sigmaGUE", "[", "L", "]"}]}], "+", 
       RowBox[{
        RowBox[{
         RowBox[{"SinIntegral", "[", 
          RowBox[{"Pi", " ", "L"}], "]"}], "^", "2"}], "/", 
        RowBox[{"Pi", "^", "2"}]}], "-", 
       RowBox[{
        RowBox[{"SinIntegral", "[", 
         RowBox[{"Pi", " ", "L"}], "]"}], "/", "Pi"}]}]}]}], ";"}], 
   "*)"}]}]], "Input",
