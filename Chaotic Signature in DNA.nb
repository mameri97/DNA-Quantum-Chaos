   RowBox[{
    RowBox[{"meanLevels", "=", 
     RowBox[{"Mean", "[", 
      RowBox[{"Length", "/@", "spectra"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"COMMON", " ", "ENSEMBLE", " ", "KDE"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"kdeBandwidth", "=", "\"\<Silverman\>\""}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"commonKDE", "=", 
     RowBox[{"SmoothKernelDistribution", "[", 
      RowBox[{"allEnergies", ",", "kdeBandwidth"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "APPLY", " ", "THE", " ", "SAME", " ", "UNFOLDING", " ", "FUNCTION", " ", 
     "TO", " ", "EVERY", " ", "SPECTRUM"}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"unfoldingFunction", "[", 
      RowBox[{"E_", "?", "NumericQ"}], "]"}], ":=", 
     RowBox[{"meanLevels", " ", 
      RowBox[{"CDF", "[", 
       RowBox[{"commonKDE", ",", "E"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
