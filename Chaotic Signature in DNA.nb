Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"pGUE", "[", "s_", "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"32", "/", 
      RowBox[{"Pi", "^", "2"}]}], ")"}], "*", 
    RowBox[{"s", "^", "2"}], "*", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{"4", "/", "Pi"}], ")"}]}], "*", 
      RowBox[{"s", "^", "2"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"cdfGUE", "[", "s_", "]"}], ":=", 
    RowBox[{"GammaRegularized", "[", 
     RowBox[{
      RowBox[{"3", "/", "2"}], ",", "0", ",", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"4", "/", "Pi"}], ")"}], "*", 
       RowBox[{"s", "^", "2"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"pGOE", "[", "s_", "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"Pi", "/", "2"}], ")"}], "*", "s", "*", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{"Pi", "/", "4"}], ")"}]}], "*", 
      RowBox[{"s", "^", "2"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"cdfGOE", "[", "s_", "]"}], ":=", 
    RowBox[{"1", "-", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{"Pi", "/", "4"}], ")"}]}], "*", 
       RowBox[{"s", "^", "2"}]}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"pGSE", "[", "s_", "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", "^", "18"}], "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"3", "^", "6"}], "*", 
        RowBox[{"Pi", "^", "3"}]}], ")"}]}], ")"}], "*", 
    RowBox[{"s", "^", "4"}], "*", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{"64", "/", 
         RowBox[{"(", 
          RowBox[{"9", "*", "Pi"}], ")"}]}], ")"}]}], "*", 
      RowBox[{"s", "^", "2"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"cdfGSE", "[", "s_", "]"}], ":=", 
    RowBox[{"GammaRegularized", "[", 
     RowBox[{
      RowBox[{"5", "/", "2"}], ",", "0", ",", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"64", "/", 
         RowBox[{"(", 
          RowBox[{"9", "*", "Pi"}], ")"}]}], ")"}], "*", 
       RowBox[{"s", "^", "2"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"pPoisson", "[", "s_", "]"}], ":=", 
   RowBox[{"Exp", "[", 
    RowBox[{"-", "s"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"cdfPoisson", "[", "s_", "]"}], ":=", 
    RowBox[{"1", "-", 
     RowBox[{"Exp", "[", 
      RowBox[{"-", "s"}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"pSP", "[", "s_", "]"}], ":=", 
   RowBox[{"4", "*", "s", "*", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "2"}], "*", "s"}], "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{4.003043850841696*^9, 4.0030438723628564`*^9}, {
