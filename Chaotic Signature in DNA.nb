    RowBox[{
     RowBox[{"data", "=", 
      RowBox[{"Import", "[", 
       RowBox[{"file", ",", "\"\<CSV\>\""}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"energies", "=", 
      RowBox[{"Cases", "[", 
       RowBox[{
        RowBox[{"Rest", "[", "data", "]"}], ",", 
        RowBox[{
         RowBox[{"row_List", "/;", 
          RowBox[{
