       RowBox[{"{", 
        RowBox[{"321", ",", "1000"}], "}"}], "}"}]}],
     SequenceForm["Orbital counts: ", {{321, 1000}}],
     Editable->False], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"COMMON", " ", "ENSEMBLE", " ", "UNFOLDING"}], "*)"}], 
   RowBox[{
    RowBox[{"Clear", "[", 
     RowBox[{
     "binEdges", ",", "binCounts", ",", "binCenters", ",", "smoothedCounts", 
      ",", "cdfEdges", ",", "unfoldingFunction", ",", "rawMin", ",", "rawMax",
       ",", "binWidth", ",", "nBins", ",", "smoothBins", ",", "histogram"}], 
     "]"}], ";"}], "\n", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "NUMBER", " ", "OF", " ", "ORBITALS", " ", "PER", " ", "GEOMETRY"}], 
    "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nLevels", "=", 
     RowBox[{"Length", "[", 
      RowBox[{"First", "[", "spectra", "]"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "COMBINE", " ", "ALL", " ", "ENERGIES", " ", "FOR", " ", "THE", " ", 
     "COMMON", " ", "DENSITY"}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"allEnergies", "=", 
     RowBox[{"Flatten", "[", "spectra", "]"}]}], ";"}], "\[IndentingNewLine]",
    "\n", 
   RowBox[{
    RowBox[{"rawMin", "=", 
     RowBox[{"Min", "[", "allEnergies", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rawMax", "=", 
     RowBox[{"Max", "[", "allEnergies", "]"}]}], ";"}], "\[IndentingNewLine]",
    "\n", 
   RowBox[{
    RowBox[{"nBins", "=", "20000"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"binWidth", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"rawMax", "-", "rawMin"}], ")"}], "/", "nBins"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"CONSTRUCT", " ", "HISTOGRAM"}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"histogram", "=", 
     RowBox[{"HistogramList", "[", 
      RowBox[{"allEnergies", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"rawMin", "-", "binWidth"}], ",", 
         RowBox[{"rawMax", "+", "binWidth"}], ",", "binWidth"}], "}"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"binEdges", "=", 
     RowBox[{"histogram", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"binCounts", "=", 
     RowBox[{"histogram", "[", 
      RowBox[{"[", "2", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"SMOOTH", " ", "THE", " ", "HISTOGRAM"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"smoothBins", "=", "20"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"smoothedCounts", "=", 
     RowBox[{"GaussianFilter", "[", 
      RowBox[{
       RowBox[{"N", "[", "binCounts", "]"}], ",", "smoothBins"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "CONSTRUCT", " ", "THE", " ", "CUMULATIVE", " ", "COUNTING", " ", 
     "FUNCTION"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cdfEdges", "=", 
     RowBox[{"nLevels", "*", 
      RowBox[{
       RowBox[{"Prepend", "[", 
        RowBox[{
         RowBox[{"Accumulate", "[", "smoothedCounts", "]"}], ",", "0."}], 
        "]"}], "/", 
       RowBox[{"Total", "[", "smoothedCounts", "]"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"CHECK", " ", "DIMENSIONS"}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<bin width: \>\"", ",", "binWidth"}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Number of bins: \>\"", ",", 
      RowBox[{"Length", "[", "binCounts", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Number of bin edges: \>\"", ",", 
      RowBox[{"Length", "[", "binEdges", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Number of CDF values: \>\"", ",", 
      RowBox[{"Length", "[", "cdfEdges", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Total histogram counts: \>\"", ",", 
      RowBox[{"Total", "[", "binCounts", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<CDF minimum: \>\"", ",", 
      RowBox[{"First", "[", "cdfEdges", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<CDF maximum: \>\"", ",", 
      RowBox[{"Last", "[", "cdfEdges", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"CREATE", " ", "THE", " ", "UNFOLDING", " ", "FUNCTION"}], "*)"}],
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", "binEdges", "]"}], "\[NotEqual]", 
       RowBox[{"Length", "[", "cdfEdges", "]"}]}], ",", 
      RowBox[{
       RowBox[{"Print", "[", "\"\<Error: Incompatible dimensions.\>\"", "]"}],
        ";", "\[IndentingNewLine]", 
       RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"unfoldingFunction", "=", 
     RowBox[{"Interpolation", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"binEdges", ",", "cdfEdges"}], "}"}], "]"}], ",", 
       RowBox[{"InterpolationOrder", "\[Rule]", "1"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"UNFOLD", " ", "EACH", " ", "GEOMETRY"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"unfoldedSpectra", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"unfoldingFunction", "/@", "#"}], ")"}], "&"}], "/@", 
      "spectra"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Unfolding completed successfully.\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"NUMBER", " ", "VARIANCE"}], "*)"}], 
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"intervalCounts", ",", "numberVarianceOne"}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"intervalCounts", "[", 
      RowBox[{"levels_List", ",", "starts_List", ",", 
       RowBox[{"len_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"n", "=", 
          RowBox[{"Length", "[", "levels", "]"}]}], ",", 
         RowBox[{"left", "=", "1"}], ",", 
         RowBox[{"right", "=", "1"}], ",", 
         RowBox[{"counts", "=", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0", ",", 
            RowBox[{"Length", "[", "starts", "]"}]}], "]"}]}], ",", "t"}], 
        "}"}], ",", 
       RowBox[{
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"t", "=", 
            RowBox[{"starts", "[", 
             RowBox[{"[", "j", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"While", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"left", "\[LessEqual]", "n"}], "&&", 
              RowBox[{
               RowBox[{"levels", "[", 
                RowBox[{"[", "left", "]"}], "]"}], "<", "t"}]}], ",", 
             RowBox[{"left", "++"}]}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"right", "<", "left"}], ",", 
             RowBox[{"right", "=", "left"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"While", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"right", "\[LessEqual]", "n"}], "&&", 
              RowBox[{
               RowBox[{"levels", "[", 
                RowBox[{"[", "right", "]"}], "]"}], "<", 
               RowBox[{"t", "+", "len"}]}]}], ",", 
             RowBox[{"right", "++"}]}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"counts", "[", 
             RowBox[{"[", "j", "]"}], "]"}], "=", 
            RowBox[{"right", "-", "left"}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", 
            RowBox[{"Length", "[", "starts", "]"}]}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", "counts"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"numberVarianceOne", "[", 
      RowBox[{"levels_List", ",", 
       RowBox[{"L_", "?", "NumericQ"}], ",", "nStarts_Integer", ",", 
       RowBox[{"edgeTrim_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"u", ",", "tMin", ",", "tMax", ",", "starts", ",", "counts"}],
         "}"}], ",", 
       RowBox[{
        RowBox[{"u", "=", 
         RowBox[{"Sort", "[", 
          RowBox[{"N", "[", "levels", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "u", "]"}], "<", "2"}], "||", 
           RowBox[{"L", "\[LessEqual]", "0"}]}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"Missing", "[", "\"\<Invalid\>\"", "]"}], "]"}]}], "]"}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"tMin", "=", 
         RowBox[{
          RowBox[{"First", "[", "u", "]"}], "+", "edgeTrim"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"tMax", "=", 
         RowBox[{
          RowBox[{"Last", "[", "u", "]"}], "-", "L", "-", "edgeTrim"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"tMax", "\[LessEqual]", "tMin"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"Missing", "[", "\"\<TooShort\>\"", "]"}], "]"}]}], "]"}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"starts", "=", 
         RowBox[{"Subdivide", "[", 
          RowBox[{"tMin", ",", "tMax", ",", "nStarts"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"counts", "=", 
         RowBox[{"intervalCounts", "[", 
          RowBox[{"u", ",", "starts", ",", "L"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Mean", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"counts", "-", "L"}], ")"}], "^", "2"}], "]"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"ENSEMBLE", " ", "AVERAGING"}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"numberVarianceEnsemble", "[", 
      RowBox[{
      "unfolded_List", ",", "Lvalues_List", ",", "nStarts_Integer", ",", 
       RowBox[{"edgeTrim_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", "vals", "}"}], ",", 
         RowBox[{
          RowBox[{"vals", "=", 
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"numberVarianceOne", "[", 
                RowBox[{"#", ",", "ell", ",", "nStarts", ",", "edgeTrim"}], 
                "]"}], "&"}], "/@", "unfolded"}], ",", "NumericQ"}], "]"}]}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "vals", "]"}], "\[GreaterEqual]", "2"}], 
            ",", 
            RowBox[{"{", 
             RowBox[{"ell", ",", 
              RowBox[{"Mean", "[", "vals", "]"}], ",", 
              RowBox[{
               RowBox[{"StandardDeviation", "[", "vals", "]"}], "/", 
               RowBox[{"Sqrt", "[", 
                RowBox[{"Length", "[", "vals", "]"}], "]"}]}], ",", 
              RowBox[{"Length", "[", "vals", "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"ell", ",", "Indeterminate", ",", "Indeterminate", ",", 
              RowBox[{"Length", "[", "vals", "]"}]}], "}"}]}], "]"}]}]}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"ell", ",", "Lvalues"}], "}"}]}], "]"}]}], ";"}]}]}]], "Input",
