Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"GOEDeviation", "=", 
   RowBox[{"Mean", "[", 
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{"empiricalCurve", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "2"}], "]"}], "]"}], "-", 
      RowBox[{"GOECurve", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"PoissonDeviation", "=", 
   RowBox[{"Mean", "[", 
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{"empiricalCurve", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "2"}], "]"}], "]"}], "-", 
      RowBox[{"poissonCurve", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SemiPoissonDeviation", "=", 
    RowBox[{"Mean", "[", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"empiricalCurve", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "2"}], "]"}], "]"}], "-", 
       RowBox[{"semiPoissonCurve", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"RESULTS", " ", "TABLE"}], "*)"}]}], "\n", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<Ensemble\>\"", ",", "\"\<Mean Absolute Error\>\""}], "}"}],
      ",", 
     RowBox[{"{", 
      RowBox[{"\"\<GOE\>\"", ",", 
       RowBox[{"NumberForm", "[", 
        RowBox[{"GOEDeviation", ",", 
         RowBox[{"{", 
          RowBox[{"8", ",", "4"}], "}"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Poisson\>\"", ",", 
       RowBox[{"NumberForm", "[", 
        RowBox[{"PoissonDeviation", ",", 
         RowBox[{"{", 
          RowBox[{"8", ",", "4"}], "}"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Semi-Poisson\>\"", ",", 
       RowBox[{"NumberForm", "[", 
        RowBox[{"SemiPoissonDeviation", ",", 
         RowBox[{"{", 
          RowBox[{"8", ",", "4"}], "}"}]}], "]"}]}], "}"}]}], "}"}], ",", 
   RowBox[{"Frame", "\[Rule]", "All"}], ",", 
   RowBox[{"Alignment", "\[Rule]", "Center"}]}], "]"}]}], "Input",
 CellChangeTimes->{{4.0042351013289375`*^9, 4.004235101333938*^9}, {
  4.004235166737941*^9, 4.0042351730415955`*^9}},
