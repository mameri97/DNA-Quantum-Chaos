Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Lvalues", "=", 
    RowBox[{"Range", "[", 
     RowBox[{"0.5", ",", "20", ",", "0.5"}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nStarts", "=", "150"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"edgeTrim", "=", "5"}], ";"}]}], "Input",
 CellChangeTimes->{{4.0042396129874477`*^9, 4.004239612994444*^9}},
 CellLabel->
