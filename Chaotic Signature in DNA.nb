Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"2.", " ", "DEFINE", " ", "POLYNOMIAL", " ", "UNFOLDING"}], 
     "&"}], " ", "NORMALIZATION", " ", "FUNCTION", " ", "FOR", " ", "A", " ", 
    "SINGLE", " ", "FILE"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ProcessSingleFile", "[", "filePath_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "importedData", ",", "rawEnergies", ",", "sortedLevels", ",", "nTotal",
         ",", "trimCount", ",", "coreLevels", ",", "nCore", ",", "indices", 
        ",", "polyDegree", ",", "fit", ",", "unfoldedLevels", ",", "spacings",
         ",", "meanS", ",", "normSpacings"}], "}"}], ",", 
      RowBox[{"(*", 
       RowBox[{
       "Import", " ", "CSV", " ", "as", " ", "raw", " ", "Data", " ", 
        "table"}], "*)"}], 
      RowBox[{
       RowBox[{"importedData", "=", 
        RowBox[{"Import", "[", 
         RowBox[{"filePath", ",", "\"\<Data\>\""}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "importedData", "]"}], "\[LessEqual]", "1"}],
          ",", 
         RowBox[{"Return", "[", 
          RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Extract", " ", "energy", " ", "column", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"column", " ", "4"}], ":", 
           "\"\<orbital_energy_hartree\>\""}], ")"}]}], "*)"}], 
       RowBox[{"rawEnergies", "=", 
        RowBox[{"ToExpression", "[", 
         RowBox[{
          RowBox[{"Rest", "[", "importedData", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "5"}], "]"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sortedLevels", "=", 
        RowBox[{"Sort", "[", 
         RowBox[{"N", "[", 
          RowBox[{"DeleteCases", "[", 
           RowBox[{"rawEnergies", ",", 
            RowBox[{
            "_Missing", "|", "Null", "|", "\"\<\>\"", "|", "_String"}]}], 
           "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"nTotal", "=", 
        RowBox[{"Length", "[", "sortedLevels", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"nTotal", "<", "20"}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Skip", " ", "files", " ", "with", " ", "too", " ", "few", " ", 
         "levels"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Band", "-", 
         RowBox[{"edge", " ", "trimming", " ", 
          RowBox[{"(", 
           RowBox[{"outer", " ", "10", "%"}], ")"}], " ", "to", " ", "remove",
           " ", "finite"}], "-", 
         RowBox[{"size", " ", "boundary", " ", "effects"}]}], "*)"}], 
       RowBox[{"trimCount", "=", 
        RowBox[{"Floor", "[", 
         RowBox[{"0.1", "*", "nTotal"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"coreLevels", "=", 
        RowBox[{"Take", "[", 
         RowBox[{"sortedLevels", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"trimCount", "+", "1"}], ",", 
            RowBox[{"nTotal", "-", "trimCount"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"nCore", "=", 
        RowBox[{"Length", "[", "coreLevels", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"nCore", "<", "10"}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"{", "}"}], "]"}]}], "]"}], ";", 
       RowBox[{"(*", 
        RowBox[{"Polynomial", " ", "Unfolding", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Using", "'"}], 
           RowBox[{"x", "'"}], " ", "instead", " ", 
           RowBox[{"of", "'"}], 
           RowBox[{"E", "'"}]}], ")"}]}], "*)"}], 
       RowBox[{"indices", "=", 
        RowBox[{"Range", "[", 
         RowBox[{"1", ",", "nCore"}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\n", 
       RowBox[{"(*", 
        RowBox[{
        "Fit", " ", "cumulative", " ", "level", " ", "count", " ", "with", 
         " ", "a", " ", "smooth", " ", "polynomial", " ", "using", " ", 
         RowBox[{"variable", "'"}], 
         RowBox[{"x", "'"}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"polyDegree", "=", "6"}], ";", "\n", 
       RowBox[{"fit", "=", 
        RowBox[{"Fit", "[", 
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{"coreLevels", ",", "indices"}], "}"}], "]"}], ",", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"x", "^", "k"}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", "0", ",", "polyDegree"}], "}"}]}], "]"}], ",", 
          "x"}], "]"}]}], ";", "\[IndentingNewLine]", "\n", 
       RowBox[{"(*", 
        RowBox[{
        "Transform", " ", "core", " ", "energy", " ", "levels", " ", "into", 
         " ", "unfolded", " ", "levels", " ", 
         RowBox[{"using", "'"}], 
         RowBox[{"x", "'"}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"unfoldedLevels", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"fit", "/.", 
           RowBox[{"x", "\[Rule]", "e"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"e", ",", "coreLevels"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Compute", " ", "nearest"}], "-", 
         RowBox[{
         "neighbor", " ", "unfolded", " ", "level", " ", "spacings"}]}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"spacings", "=", 
        RowBox[{"Differences", "[", "unfoldedLevels", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "spacings", "]"}], "\[Equal]", "0"}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Normalize", " ", "spacings", " ", "so", " ", "mean"}], "=", 
         "1.0"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"meanS", "=", 
        RowBox[{"Mean", "[", "spacings", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"meanS", "\[LessEqual]", "0"}], "||", 
          RowBox[{"!", 
           RowBox[{"NumberQ", "[", "meanS", "]"}]}]}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"normSpacings", "=", 
        RowBox[{"spacings", "/", "meanS"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Filter", " ", "strictly", " ", "within", " ", "plot", " ", "range", 
         " ", 
         RowBox[{"(", 
          RowBox[{"0", " ", "to", " ", "3.5"}], ")"}]}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"Select", "[", 
        RowBox[{"normSpacings", ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"#", ">", "0"}], "&&", 
            RowBox[{"#", "\[LessEqual]", "3.5"}]}], ")"}], "&"}]}], "]"}]}]}],
      "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{4.0031968769005747`*^9, 4.0031968769045744`*^9}, {
   4.003196929817906*^9, 4.0031969505977583`*^9}, {4.0031972658994946`*^9, 
   4.00319728912535*^9}, 4.0031973325907755`*^9, 4.0032055776226387`*^9, {
   4.0032060805267015`*^9, 4.0032060842522326`*^9}},
 CellLabel->
  "In[242]:=",ExpressionUUID->"c847ae4b-8ef5-4920-a669-d075575f7bba"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "3.", " ", "PROCESS", " ", "ALL", " ", "FILES", " ", "IN", " ", "PARALLEL",
     " ", "AND", " ", "FLATTEN"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"AllSpacingsLinear", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"ParallelTable", "[", 
       RowBox[{
        RowBox[{"ProcessSingleFile", "[", "file", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"file", ",", "filePaths"}], "}"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{
     "\"\<Total pooled normalized spacings across all files: \>\"", ",", 
      RowBox[{"Length", "[", "AllSpacingsLinear", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Ensemble Mean Spacing: \>\"", ",", 
      RowBox[{"N", "[", 
       RowBox[{"Mean", "[", "AllSpacingsLinear", "]"}], "]"}]}], "]"}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{4.0032060884412374`*^9, 4.0032060948072324`*^9}},
