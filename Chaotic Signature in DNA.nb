Cell[TextData[StyleBox["Comparison with Erlang and Chi-squared",
 FontWeight->"Bold"]], "Subsection",
 CellChangeTimes->{{4.0038303650076375`*^9, 
  4.003830379578171*^9}},ExpressionUUID->"e8e51ee8-2e72-40af-a28b-\
5dd1cefb9401"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Define", " ", "an", " ", "Erlang", " ", "distribution", " ", "with", " ",
      "shape", " ", "k"}], "=", 
    RowBox[{
     RowBox[{"3", " ", "and", " ", "rate", " ", "lambda"}], "=", "0.5"}]}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"dist", "=", 
     RowBox[{"ErlangDistribution", "[", 
      RowBox[{"3", ",", "0.5"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Find", " ", "the", " ", "mean", " ", "and", " ", "variance"}], 
    "*)"}], "\n", 
   RowBox[{"Mean", "[", "dist", "]"}], "\n", 
   RowBox[{"Variance", "[", "dist", "]"}]}]}]], "Input",
 CellChangeTimes->{{4.0033769630293903`*^9, 4.0033769672002773`*^9}},
 CellLabel->
  "In[308]:=",ExpressionUUID->"34067ea1-fc18-4438-adbd-4892fea0a778"],

