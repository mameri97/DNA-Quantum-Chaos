Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"DEFINE", " ", "UNFOLDING"}], "&"}], " ", "NORMALIZATION", " ", 
    "FUNCTION", " ", "FOR", " ", "A", " ", "SINGLE", " ", "FILE"}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ProcessSingleFile", "[", "filePath_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "importedData", ",", "rawEnergies", ",", "sortedLevels", ",", "nTotal",
         ",", "trimCount", ",", "coreLevels", ",", "nCore", ",", "kdeDist", 
        ",", "unfoldedLevels", ",", "spacings", ",", "meanS", ",", 
        "normSpacings"}], "}"}], ",", 
      RowBox[{
       RowBox[{"importedData", "=", 
        RowBox[{"Import", "[", 
         RowBox[{"filePath", ",", "\"\<Data\>\""}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "importedData", "]"}], "\[LessEqual]", "1"}],
          ",", 
         RowBox[{"Return", "[", 
          RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"Extract", " ", "energy", " ", "column"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"rawEnergies", "=", 
        RowBox[{"ToExpression", "[", 
         RowBox[{
          RowBox[{"Rest", "[", "importedData", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "5"}], "]"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sortedLevels", "=", 
        RowBox[{"Sort", "[", 
         RowBox[{"N", "[", 
          RowBox[{"DeleteCases", "[", 
           RowBox[{"rawEnergies", ",", 
            RowBox[{
            "_Missing", "|", "Null", "|", "\"\<\>\"", "|", "_String"}]}], 
           "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"nTotal", "=", 
        RowBox[{"Length", "[", "sortedLevels", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"nTotal", "<", "20"}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"Band", "-", 
         RowBox[{"edge", " ", "trimming", " ", 
          RowBox[{"(", 
           RowBox[{"outer", " ", "10", "%"}], ")"}]}]}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"trimCount", "=", 
        RowBox[{"Floor", "[", 
         RowBox[{"0.1", "*", "nTotal"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"coreLevels", "=", 
        RowBox[{"Take", "[", 
         RowBox[{"sortedLevels", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"trimCount", "+", "1"}], ",", 
            RowBox[{"nTotal", "-", "trimCount"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"nCore", "=", 
        RowBox[{"Length", "[", "coreLevels", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"nCore", "<", "10"}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"Gaussian", " ", "KDE", " ", "Unfolding"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"kdeDist", "=", 
        RowBox[{"SmoothKernelDistribution", "[", "coreLevels", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"unfoldedLevels", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"nCore", "*", 
           RowBox[{"CDF", "[", 
            RowBox[{"kdeDist", ",", "e"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"e", ",", "coreLevels"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"Spacings", "&"}], " ", "Local", " ", "Normalization"}], " ",
         "*)"}], "\[IndentingNewLine]", 
       RowBox[{"spacings", "=", 
        RowBox[{"Differences", "[", "unfoldedLevels", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "spacings", "]"}], "\[Equal]", "0"}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"meanS", "=", 
        RowBox[{"Mean", "[", "spacings", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"meanS", "\[LessEqual]", "0"}], "||", 
          RowBox[{"!", 
           RowBox[{"NumberQ", "[", "meanS", "]"}]}]}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"normSpacings", "=", 
        RowBox[{"spacings", "/", "meanS"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Filter", " ", "strictly", " ", "within", " ", "plot", " ", "range", 
         " ", "boundary"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"Select", "[", 
        RowBox[{"normSpacings", ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"#", ">", "0"}], "&&", 
            RowBox[{"#", "\[LessEqual]", "3.5"}]}], ")"}], "&"}]}], "]"}]}]}],
      "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{4.0031966914009333`*^9, 4.003196783084219*^9}, 
   4.003196886460707*^9, 4.003205211680318*^9, 4.0032054202208652`*^9, 
   4.0032055492574697`*^9},
 CellLabel->
  "In[350]:=",ExpressionUUID->"108f8234-74c9-4977-b666-6dd72695ee2e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "PROCESS", " ", "ALL", " ", "FILES", " ", "IN", " ", "PARALLEL", " ", 
    "AND", " ", "FLATTEN"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"AllSpacingsKDEBoth", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"ParallelTable", "[", 
       RowBox[{
        RowBox[{"ProcessSingleFile", "[", "file", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"file", ",", "filePaths"}], "}"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{
     "\"\<Total pooled normalized spacings across all files: \>\"", ",", 
      RowBox[{"Length", "[", "AllSpacingsKDEBoth", "]"}]}], "]"}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Ensemble Mean Spacing: \>\"", ",", 
      RowBox[{"N", "[", 
       RowBox[{"Mean", "[", "AllSpacingsKDEBoth", "]"}], "]"}]}], "]"}], 
    ";"}]}]}]], "Input",
