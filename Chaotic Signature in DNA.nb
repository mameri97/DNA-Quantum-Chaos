    "Construct", " ", "ONE", " ", "KDE", " ", "from", " ", "the", " ", 
     "entire", " ", "ensemble"}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"commonKDE", "=", 
     RowBox[{"Quiet", "@", 
      RowBox[{"Check", "[", 
