Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "9.", " ", "THEORETICAL", " ", "NUMBER", " ", "VARIANCE", " ", "CURVES"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"for", " ", "large", " ", "L"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"sigmaPoisson", "[", 
      RowBox[{"L_", "?", "NumericQ"}], "]"}], ":=", "L"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"sigmaSemiPoisson", "[", 
      RowBox[{"L_", "?", "NumericQ"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"L", "/", "2"}], "+", 
      RowBox[{"1", "/", "8"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"sigmaGOE", "[", 
      RowBox[{"L_", "?", "NumericQ"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", "/", 
        RowBox[{"Pi", "^", "2"}]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Log", "[", 
         RowBox[{"2", " ", "Pi", " ", "L"}], "]"}], "+", "EulerGamma", "+", 
        "1", "-", 
        RowBox[{
         RowBox[{"Pi", "^", "2"}], "/", "8"}]}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"sigmaPoisson", "[", 
       RowBox[{"L_", "?", "NumericQ"}], "]"}], ":=", "L"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"sigmaSemiPoisson", "[", 
       RowBox[{"L_", "?", "NumericQ"}], "]"}], ":=", 
      RowBox[{
       RowBox[{"L", "/", "2"}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "4"}], " ", "L"}], "]"}]}], ")"}], "/", "8"}]}]}], 
     ";", "\n", 
     RowBox[{
      RowBox[{"sigmaGUE", "[", 
       RowBox[{"L_", "?", "NumericQ"}], "]"}], ":=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Log", "[", 
           RowBox[{"2", " ", "Pi", " ", "L"}], "]"}], "+", "EulerGamma", "+", 
          "1", "-", 
          RowBox[{"Cos", "[", 
           RowBox[{"2", " ", "Pi", " ", "L"}], "]"}], "-", 
          RowBox[{"CosIntegral", "[", 
           RowBox[{"2", " ", "Pi", " ", "L"}], "]"}]}], ")"}], "/", 
        RowBox[{"Pi", "^", "2"}]}], "+", 
       RowBox[{"L", " ", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"2", " ", 
           RowBox[{
            RowBox[{"SinIntegral", "[", 
             RowBox[{"2", " ", "Pi", " ", "L"}], "]"}], "/", "Pi"}]}]}], 
         ")"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"sigmaGOE", "[", 
       RowBox[{"L_", "?", "NumericQ"}], "]"}], ":=", 
      RowBox[{
       RowBox[{"2", " ", 
        RowBox[{"sigmaGUE", "[", "L", "]"}]}], "+", 
       RowBox[{
        RowBox[{
         RowBox[{"SinIntegral", "[", 
          RowBox[{"Pi", " ", "L"}], "]"}], "^", "2"}], "/", 
        RowBox[{"Pi", "^", "2"}]}], "-", 
       RowBox[{
        RowBox[{"SinIntegral", "[", 
         RowBox[{"Pi", " ", "L"}], "]"}], "/", "Pi"}]}]}], ";"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Generate", " ", "theoretical", " ", "curves"}], "*)"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"poissonCurve", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"L", ",", 
         RowBox[{"sigmaPoisson", "[", "L", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"L", ",", "Lvalues"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"semiPoissonCurve", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"L", ",", 
         RowBox[{"sigmaSemiPoisson", "[", "L", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"L", ",", "Lvalues"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"GOECurve", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"L", ",", 
         RowBox[{"sigmaGOE", "[", "L", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"L", ",", "Lvalues"}], "}"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Empirical", " ", "KDE", " ", "curve"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"empiricalCurve", "=", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"commonKDEResults", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "]"}], ",", 
       RowBox[{
        RowBox[{"NumericQ", "[", 
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "]"}], "&"}]}], "]"}]}], 
    ";"}]}]}]], "Input",
