}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Old code for number variance",
 FontWeight->"Bold"]], "Subsection",
 CellChangeTimes->{{4.004234434537202*^9, 
  4.0042344425697274`*^9}},ExpressionUUID->"3ebc4d25-b2a8-4ad6-8584-\
0def1dae31ce"],

Cell[TextData[StyleBox["Main Code (old code)",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{4.0042256534565325`*^9, 4.0042256548060703`*^9}, {
  4.0042320340913286`*^9, 
  4.004232044615286*^9}},ExpressionUUID->"e241fe56-1b2d-4111-9967-\
66f4a5fa1cf5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"IMPORT", " ", "ALL", " ", "ORBITAL", " ", "SPECTRA"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"folder", "=", 
     RowBox[{"SystemDialogInput", "[", "\"\<Directory\>\"", "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"folder", "===", "$Canceled"}], ",", 
      RowBox[{"Abort", "[", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"files", "=", 
     RowBox[{"Sort", "@", 
      RowBox[{"FileNames", "[", 
       RowBox[{"\"\<frame_*.csv\>\"", ",", "folder"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Files found: \>\"", ",", 
      RowBox[{"Length", "[", "files", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"EXTRACT", " ", "ALL", " ", "ORBITAL", " ", "ENERGIES"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"readSpectrum", "[", "file_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"data", ",", "energies"}], "}"}], ",", 
       RowBox[{
        RowBox[{"data", "=", 
         RowBox[{"Quiet", "@", 
          RowBox[{"Check", "[", 
           RowBox[{
            RowBox[{"Import", "[", 
             RowBox[{"file", ",", "\"\<CSV\>\""}], "]"}], ",", "$Failed"}], 
           "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"data", "===", "$Failed"}], "||", 
           RowBox[{"!", 
            RowBox[{"ListQ", "[", "data", "]"}]}], "||", 
           RowBox[{
            RowBox[{"Length", "[", "data", "]"}], "<", "2"}]}], ",", 
          RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"!", 
            RowBox[{"ListQ", "[", 
             RowBox[{"First", "[", "data", "]"}], "]"}]}], "||", 
           RowBox[{
            RowBox[{"Length", "[", 
             RowBox[{"First", "[", "data", "]"}], "]"}], "<", "5"}]}], ",", 
          RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"energies", "=", 
         RowBox[{"Quiet", "@", 
          RowBox[{"Check", "[", 
           RowBox[{
            RowBox[{"N", "[", 
             RowBox[{"data", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"2", ";;"}], ",", "5"}], "]"}], "]"}], "]"}], ",", 
            "$Failed"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"energies", "===", "$Failed"}], "||", 
           RowBox[{"!", 
            RowBox[{"VectorQ", "[", 
             RowBox[{"energies", ",", "NumericQ"}], "]"}]}]}], ",", 
          RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Sort", "[", "energies", "]"}]}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rawSpectra", "=", 
     RowBox[{"readSpectrum", "/@", "files"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"validPairs", "=", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"#1", ",", "#2"}], "}"}], "&"}], ",", 
         RowBox[{"{", 
          RowBox[{"files", ",", "rawSpectra"}], "}"}]}], "]"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "=!=", "$Failed"}], "&"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", "validPairs", "]"}], "\[Equal]", "0"}], ",", 
      RowBox[{"Abort", "[", "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"validFiles", "=", 
     RowBox[{"validPairs", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"spectra", "=", 
     RowBox[{"validPairs", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Valid spectra: \>\"", ",", 
      RowBox[{"Length", "[", "spectra", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Invalid files: \>\"", ",", 
      RowBox[{
       RowBox[{"Length", "[", "files", "]"}], "-", 
       RowBox[{"Length", "[", "spectra", "]"}]}]}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lengths", "=", 
     RowBox[{"Length", "/@", "spectra"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Orbital counts: \>\"", ",", 
      RowBox[{"Tally", "[", "lengths", "]"}]}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", 
        RowBox[{"DeleteDuplicates", "[", "lengths", "]"}], "]"}], 
       "\[NotEqual]", "1"}], ",", 
      RowBox[{
       RowBox[{
       "Print", "[", 
        "\"\<Error: The files contain different numbers of orbitals.\>\"", 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{
    RowBox[{"nLevels", "=", 
     RowBox[{"First", "[", "lengths", "]"}]}], ";"}], "\n", 
   RowBox[{
    InterpretationBox[
     RowBox[{"\"\<Valid spectra: \>\"", "\[InvisibleSpace]", "1000"}],
     SequenceForm["Valid spectra: ", 1000],
     Editable->False], ";"}], "\n", 
   RowBox[{
    InterpretationBox[
     RowBox[{"\"\<Invalid files: \>\"", "\[InvisibleSpace]", "0"}],
     SequenceForm["Invalid files: ", 0],
     Editable->False], ";"}], "\n", 
   RowBox[{
    InterpretationBox[
     RowBox[{"\"\<Orbital counts: \>\"", "\[InvisibleSpace]", 
