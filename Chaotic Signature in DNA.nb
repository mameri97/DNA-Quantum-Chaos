Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"6.", " ", "NUMBER", " ", 
    RowBox[{"VARIANCE", ":", 
     RowBox[{"INTERVAL", " ", "COUNTING"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"intervalCounts", ",", "numberVarianceOne"}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Count", " ", "levels", " ", "in", " ", 
      RowBox[{"intervals", "[", 
       RowBox[{"x", ",", 
        RowBox[{"x", "+", "L"}]}]}]}], ")"}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"intervalCounts", "[", 
      RowBox[{"levels_List", ",", "starts_List", ",", 
       RowBox[{"len_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"n", "=", 
          RowBox[{"Length", "[", "levels", "]"}]}], ",", 
         RowBox[{"left", "=", "1"}], ",", 
         RowBox[{"right", "=", "1"}], ",", 
         RowBox[{"counts", "=", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0", ",", 
            RowBox[{"Length", "[", "starts", "]"}]}], "]"}]}], ",", "t"}], 
        "}"}], ",", 
       RowBox[{
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"t", "=", 
            RowBox[{"starts", "[", 
             RowBox[{"[", "j", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"While", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"left", "\[LessEqual]", "n"}], "&&", 
              RowBox[{
               RowBox[{"levels", "[", 
                RowBox[{"[", "left", "]"}], "]"}], "<", "t"}]}], ",", 
             RowBox[{"left", "++"}]}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"right", "<", "left"}], ",", 
             RowBox[{"right", "=", "left"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"While", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"right", "\[LessEqual]", "n"}], "&&", 
              RowBox[{
               RowBox[{"levels", "[", 
                RowBox[{"[", "right", "]"}], "]"}], "<", 
               RowBox[{"t", "+", "len"}]}]}], ",", 
             RowBox[{"right", "++"}]}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"counts", "[", 
             RowBox[{"[", "j", "]"}], "]"}], "=", 
            RowBox[{"right", "-", "left"}]}], ";"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", 
            RowBox[{"Length", "[", "starts", "]"}]}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", "counts"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Number", " ", "variance", " ", "for", " ", "one", " ", "geometry"}], 
    "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"numberVarianceOne", "[", 
      RowBox[{"levels_List", ",", 
       RowBox[{"L_", "?", "NumericQ"}], ",", "nStarts_Integer", ",", 
       RowBox[{"edgeTrim_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"u", ",", "tMin", ",", "tMax", ",", "starts", ",", "counts"}],
         "}"}], ",", 
       RowBox[{
        RowBox[{"u", "=", 
         RowBox[{"Sort", "[", 
          RowBox[{"N", "[", "levels", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "u", "]"}], "<", "2"}], "||", 
           RowBox[{"L", "\[LessEqual]", "0"}]}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"Missing", "[", "\"\<Invalid\>\"", "]"}], "]"}]}], "]"}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Remove", " ", "edge", " ", "regions"}], "*)"}], 
        RowBox[{"tMin", "=", 
         RowBox[{
          RowBox[{"First", "[", "u", "]"}], "+", "edgeTrim"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"tMax", "=", 
         RowBox[{
          RowBox[{"Last", "[", "u", "]"}], "-", "L", "-", "edgeTrim"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"tMax", "\[LessEqual]", "tMin"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"Missing", "[", "\"\<TooShort\>\"", "]"}], "]"}]}], "]"}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Generate", " ", "equally", " ", "spaced", " ", "window", " ", 
          "positions"}], "*)"}], 
        RowBox[{"starts", "=", 
         RowBox[{"N", "[", 
          RowBox[{"Subdivide", "[", 
           RowBox[{"tMin", ",", "tMax", ",", "nStarts"}], "]"}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Count", " ", "levels", " ", "in", " ", "all", " ", "windows"}], 
         "*)"}], 
        RowBox[{"counts", "=", 
         RowBox[{"intervalCounts", "[", 
          RowBox[{"u", ",", "starts", ",", "L"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Calculate", " ", "number", " ", "variance"}], "*)"}], 
        RowBox[{"Mean", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"counts", "-", "L"}], ")"}], "^", "2"}], "]"}]}]}], 
      "]"}]}], ";"}]}]}]], "Input",
 CellLabel->
  "In[1775]:=",ExpressionUUID->"fb9a0182-1392-4986-a3a2-da439f5c923a"],

