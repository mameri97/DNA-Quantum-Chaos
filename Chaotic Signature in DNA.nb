Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Define", " ", "theoretical", " ", "r"}], "-", 
     RowBox[{"distribution", " ", "functions", " ", "for", " ", "k"}]}], "=", 
    "1"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Poisson", ":", 
     RowBox[{"P", 
      RowBox[{"(", "r", ")"}]}]}], "=", 
    RowBox[{"2", "/", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", "r"}], ")"}], "^", "2"}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"pPoisson", "[", "x_", "]"}], ":=", 
     RowBox[{"2", "/", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", "x"}], ")"}], "^", "2"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Semi", "-", 
      RowBox[{"Poisson", ":", 
       RowBox[{"P", 
        RowBox[{"(", "r", ")"}]}]}]}], "=", 
     RowBox[{"6", 
      RowBox[{"r", "/", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "+", "r"}], ")"}], "^", "4"}]}]}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"pSemiPoisson", "[", "x_", "]"}], ":=", 
     RowBox[{"6", "*", 
      RowBox[{"x", "/", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "+", "x"}], ")"}], "^", "4"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"GOE", " ", "distribution", " ", 
     RowBox[{"(", 
      RowBox[{
      "approximate", " ", "analytic", " ", "form", " ", "for", " ", "r"}], 
      ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Or", " ", "use", " ", "a", " ", "histogram", " ", "of", " ", "your", " ",
      "pooled", " ", "r", " ", "values"}], "*)"}], "\n", 
   "\[IndentingNewLine]", 
