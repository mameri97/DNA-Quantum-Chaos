Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"BANDWIDTH", " ", "MULTIPLIERS"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"bandwidthMultipliers", "=", 
     RowBox[{"{", 
      RowBox[{"0.5", ",", "1", ",", "1.5", ",", "2"}], "}"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "PROCESS", " ", "ONE", " ", "FILE", " ", "WITH", " ", "A", " ", 
     "SPECIFIED", " ", "BANDWIDTH"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"ProcessOrbitalsBW", "[", 
      RowBox[{"filePath_", ",", "type_", ",", "multiplier_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "data", ",", "rows", ",", "records", ",", "selectedLevels", ",", 
         "sortedLevels", ",", "nTotal", ",", "trimCount", ",", "coreLevels", 
         ",", "nCore", ",", "h0", ",", "h", ",", "kdeDist", ",", 
         "unfoldedLevels", ",", "spacings", ",", "meanS"}], "}"}], ",", 
       RowBox[{
        RowBox[{"data", "=", 
         RowBox[{"Import", "[", 
          RowBox[{"filePath", ",", "\"\<Data\>\""}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "data", "]"}], "\[LessEqual]", "1"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"rows", "=", 
         RowBox[{"Rest", "[", "data", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"records", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"parseNum", "[", 
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", 
              RowBox[{"parseNum", "[", 
               RowBox[{"#", "[", 
                RowBox[{"[", "5", "]"}], "]"}], "]"}]}], "}"}], "&"}], ")"}], 
          "/@", 
          RowBox[{"Select", "[", 
           RowBox[{"rows", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "[", "#", "]"}], "\[GreaterEqual]", "5"}], 
             "&"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"records", "=", 
         RowBox[{"Select", "[", 
          RowBox[{"records", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"NumericQ", "[", 
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "]"}], "&&", 
             RowBox[{"NumericQ", "[", 
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "&"}]}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"selectedLevels", "=", 
         RowBox[{"Which", "[", 
          RowBox[{
           RowBox[{"type", "\[Equal]", "\"\<Occupied\>\""}], ",", 
           RowBox[{"Cases", "[", 
            RowBox[{"records", ",", 
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{"occ_", ",", "energy_"}], "}"}], "/;", 
               RowBox[{"occ", ">", "0"}]}], "\[RuleDelayed]", "energy"}]}], 
            "]"}], ",", 
           RowBox[{"type", "\[Equal]", "\"\<Virtual\>\""}], ",", 
           RowBox[{"Cases", "[", 
            RowBox[{"records", ",", 
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{"occ_", ",", "energy_"}], "}"}], "/;", 
               RowBox[{"occ", "\[Equal]", "0"}]}], "\[RuleDelayed]", 
              "energy"}]}], "]"}], ",", "True", ",", 
           RowBox[{"{", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"sortedLevels", "=", 
         RowBox[{"Sort", "[", 
          RowBox[{"N", "[", "selectedLevels", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"nTotal", "=", 
         RowBox[{"Length", "[", "sortedLevels", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"nTotal", "<", "20"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"trimCount", "=", 
         RowBox[{"Floor", "[", 
          RowBox[{"0.1", "*", "nTotal"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"coreLevels", "=", 
         RowBox[{"Take", "[", 
          RowBox[{"sortedLevels", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"trimCount", "+", "1"}], ",", 
             RowBox[{"nTotal", "-", "trimCount"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"nCore", "=", 
         RowBox[{"Length", "[", "coreLevels", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"nCore", "<", "10"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Normal", "-", 
          RowBox[{"reference", " ", "bandwidth"}]}], "*)"}], 
        RowBox[{"h0", "=", 
         RowBox[{"1.06", "*", 
          RowBox[{"StandardDeviation", "[", "coreLevels", "]"}], "*", 
          RowBox[{"nCore", "^", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "1"}], "/", "5"}], ")"}]}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"h", "=", 
         RowBox[{"multiplier", "*", "h0"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "KDE", " ", "unfolding", " ", "with", " ", "specified", " ", 
          "bandwidth"}], "*)"}], 
        RowBox[{"kdeDist", "=", 
         RowBox[{"SmoothKernelDistribution", "[", 
          RowBox[{"coreLevels", ",", "h"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"unfoldedLevels", "=", 
         RowBox[{"nCore", "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"CDF", "[", 
              RowBox[{"kdeDist", ",", "#"}], "]"}], "&"}], "/@", 
            "coreLevels"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"spacings", "=", 
         RowBox[{"Differences", "[", "unfoldedLevels", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "spacings", "]"}], "\[Equal]", "0"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"meanS", "=", 
         RowBox[{"Mean", "[", "spacings", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"!", 
            RowBox[{"NumberQ", "[", "meanS", "]"}]}], "||", 
           RowBox[{"meanS", "\[LessEqual]", "0"}]}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"spacings", "/", "meanS"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"CALCULATE", " ", "ALL", " ", "DISTRIBUTIONS"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"OccupiedResults", "=", 
     RowBox[{"Association", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ToString", "[", "mult", "]"}], "\[Rule]", 
         RowBox[{"Flatten", "[", 
          RowBox[{"ParallelTable", "[", 
           RowBox[{
            RowBox[{"ProcessOrbitalsBW", "[", 
             RowBox[{"file", ",", "\"\<Occupied\>\"", ",", "mult"}], "]"}], 
            ",", 
            RowBox[{"{", 
             RowBox[{"file", ",", "filePaths"}], "}"}]}], "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"mult", ",", "bandwidthMultipliers"}], "}"}]}], "]"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"VirtualResults", "=", 
     RowBox[{"Association", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ToString", "[", "mult", "]"}], "\[Rule]", 
         RowBox[{"Flatten", "[", 
          RowBox[{"ParallelTable", "[", 
           RowBox[{
            RowBox[{"ProcessOrbitalsBW", "[", 
             RowBox[{"file", ",", "\"\<Virtual\>\"", ",", "mult"}], "]"}], 
            ",", 
            RowBox[{"{", 
             RowBox[{"file", ",", "filePaths"}], "}"}]}], "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"mult", ",", "bandwidthMultipliers"}], "}"}]}], "]"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"PLOT", " ", "FUNCTION"}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"pGOE", "[", "s_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"Pi", "/", "2"}], ")"}], "*", "s", "*", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "Pi"}], "*", 
        RowBox[{
         RowBox[{"s", "^", "2"}], "/", "4"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"MakeBWPlot", "[", 
      RowBox[{"data_", ",", "title_"}], "]"}], ":=", 
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"Histogram", "[", 
        RowBox[{"data", ",", 
         RowBox[{"{", "0.05", "}"}], ",", "\"\<PDF\>\"", ",", 
         RowBox[{"ChartStyle", "\[Rule]", 
          RowBox[{"Directive", "[", 
           RowBox[{"Blue", ",", 
            RowBox[{"Opacity", "[", "0.6", "]"}]}], "]"}]}]}], "]"}], ",", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"pGOE", "[", "s", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"s", ",", "0", ",", "3.5"}], "}"}], ",", 
         RowBox[{"PlotStyle", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"Red", ",", "Thick"}], "}"}]}]}], "]"}], ",", 
       RowBox[{"Frame", "\[Rule]", "True"}], ",", 
       RowBox[{"FrameLabel", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<Normalized spacing s\>\"", ",", "\"\<P(s)\>\""}], 
         "}"}]}], ",", 
       RowBox[{"PlotLabel", "\[Rule]", "title"}], ",", 
       RowBox[{"PlotRange", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "3.5"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "0.8"}], "}"}]}], "}"}]}], ",", 
       RowBox[{"ImageSize", "\[Rule]", "400"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"OCCUPIED", " ", "ORBITALS"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"OccupiedBWPlots", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"MakeBWPlot", "[", 
        RowBox[{
         RowBox[{"OccupiedResults", "[", 
          RowBox[{"ToString", "[", "mult", "]"}], "]"}], ",", 
         RowBox[{"\"\<Occupied: bandwidth = \>\"", "<>", 
          RowBox[{"ToString", "[", "mult", "]"}], "<>", "\"\< h0\>\""}]}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"mult", ",", "bandwidthMultipliers"}], "}"}]}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"VIRTUAL", " ", "ORBITALS"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"VirtualBWPlots", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"MakeBWPlot", "[", 
        RowBox[{
         RowBox[{"VirtualResults", "[", 
          RowBox[{"ToString", "[", "mult", "]"}], "]"}], ",", 
         RowBox[{"\"\<Virtual: bandwidth = \>\"", "<>", 
          RowBox[{"ToString", "[", "mult", "]"}], "<>", "\"\< h0\>\""}]}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"mult", ",", "bandwidthMultipliers"}], "}"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<OCCUPIED ORBITALS\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"GraphicsGrid", "[", 
      RowBox[{"Partition", "[", 
       RowBox[{"OccupiedBWPlots", ",", "2"}], "]"}], "]"}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<VIRTUAL ORBITALS\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"GraphicsGrid", "[", 
      RowBox[{"Partition", "[", 
       RowBox[{"VirtualBWPlots", ",", "2"}], "]"}], "]"}], "]"}], ";"}], 
   "\n"}]}]], "Input",
