Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"SPECTRAL", " ", "COMPRESSIBILITY"}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"fitLmin", "=", "5"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"fitLmax", "=", "20"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"spectralCompressibility", "[", "curve_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"points", ",", "fit"}], "}"}], ",", 
       RowBox[{
        RowBox[{"points", "=", 
         RowBox[{"Select", "[", 
          RowBox[{"curve", ",", 
           RowBox[{
            RowBox[{"fitLmin", "\[LessEqual]", 
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "\[LessEqual]", "fitLmax"}], 
            "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"fit", "=", 
         RowBox[{"Fit", "[", 
          RowBox[{"points", ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "x"}], "}"}], ",", "x"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Coefficient", "[", 
         RowBox[{"fit", ",", "x"}], "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"chiData", "=", 
     RowBox[{"spectralCompressibility", "[", "empiricalCurve", "]"}]}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"chiGOE", "=", 
     RowBox[{"spectralCompressibility", "[", "GOECurve", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"chiPoisson", "=", 
     RowBox[{"spectralCompressibility", "[", "poissonCurve", "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"chiSemiPoisson", "=", 
     RowBox[{"spectralCompressibility", "[", "semiPoissonCurve", "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"{", 
