Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"for", " ", "large", " ", "L"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"sigmaPoisson", "[", "L_", "]"}], ":=", "L"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"sigmaSemiPoisson", "[", "L_", "]"}], ":=", 
     RowBox[{
      RowBox[{"L", "/", "2"}], "+", 
      RowBox[{"1", "/", "8"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"sigmaGOE", "[", "L_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", "/", 
        RowBox[{"Pi", "^", "2"}]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Log", "[", 
         RowBox[{"2", " ", "Pi", " ", "L"}], "]"}], "+", "EulerGamma", "+", 
        "1", "-", 
        RowBox[{
         RowBox[{"Pi", "^", "2"}], "/", "8"}]}], ")"}]}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{4.0039908708166294`*^9, 4.003990882627406*^9}, {
   4.0041687980741997`*^9, 4.0041688078921423`*^9}, 4.0042247105607796`*^9, {
