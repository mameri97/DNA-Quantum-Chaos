     "\"\<C:\\\\Users\\\\Mehdi \
Ameri\\\\Desktop\\\\HB-Results\\\\GC\\\\Orbital Energy Levels\>\""}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"filePaths", "=", 
     RowBox[{"FileNames", "[", 
      RowBox[{"\"\<frame_*.csv\>\"", ",", "folder"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Total files found: \>\"", ",", 
      RowBox[{"Length", "[", "filePaths", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"EXTRACT", " ", "ALL", " ", "ORBITAL", " ", "ENERGIES"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"allEnergies", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"data", "=", 
          RowBox[{"Import", "[", 
           RowBox[{"file", ",", "\"\<CSV\>\""}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Rest", "[", "data", "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "5"}], "]"}], "]"}], ",", "NumericQ"}], 
          "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"file", ",", "filePaths"}], "}"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"CALCULATE", " ", "MINIMUM", " ", "AND", " ", "MAXIMUM"}], "*)"}],
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Total orbital energies: \>\"", ",", 
      RowBox[{"Length", "[", "allEnergies", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Minimum orbital energy (eV): \>\"", ",", 
      RowBox[{"Min", "[", "allEnergies", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Maximum orbital energy (eV): \>\"", ",", 
      RowBox[{"Max", "[", "allEnergies", "]"}]}], "]"}], ";"}]}]}]], "Input",
