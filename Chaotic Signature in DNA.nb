Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"maxPlot", "=", 
    RowBox[{"Show", "[", 
     RowBox[{
      RowBox[{"Histogram", "[", 
       RowBox[{"zMax", ",", 
        RowBox[{"{", "0.25", "}"}], ",", "\"\<PDF\>\""}], "]"}], ",", 
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"twStandardizedPDF", "[", "x", "]"}], ",", 
