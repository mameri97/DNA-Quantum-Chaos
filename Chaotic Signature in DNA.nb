Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"SELECT", " ", "TRACY"}], "-", 
    RowBox[{"WIDOM", " ", "DISTRIBUTION"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"beta", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"twDist", "=", 
     RowBox[{"TracyWidomDistribution", "[", "beta", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "THEORETICAL", " ", "MEAN", " ", "AND", " ", "STANDARD", " ", 
     "DEVIATION"}], "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"twMean", "=", 
     RowBox[{"N", "[", 
      RowBox[{"Mean", "[", "twDist", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"twSD", "=", 
     RowBox[{"N", "[", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"Variance", "[", "twDist", "]"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<TW mean: \>\"", ",", "twMean"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<TW standard deviation: \>\"", ",", "twSD"}], "]"}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{4.0044330448687*^9, 4.004433046443158*^9}, {
  4.0044940518620415`*^9, 4.0044940580639124`*^9}},
 CellLabel->"In[12]:=",ExpressionUUID->"971b1f3a-cf7b-4b49-8194-85147a3240e1"],

