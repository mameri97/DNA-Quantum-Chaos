Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Define", " ", "a", " ", "Chi"}], "-", 
    RowBox[{
    "squared", " ", "distribution", " ", "with", " ", "4", " ", "degrees", 
     " ", "of", " ", "freedom"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"dist", "=", 
     RowBox[{"ChiSquareDistribution", "[", "4", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Compute", " ", "mean", " ", "and", " ", "variance"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Mean", "[", "dist", "]"}], "     ", 
   RowBox[{"(*", 
    RowBox[{"Returns", " ", "4"}], "*)"}], "\n", 
   RowBox[{"Variance", "[", "dist", "]"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Returns", " ", "8"}], "*)"}]}]}]], "Input",
 CellChangeTimes->{{4.003377966575754*^9, 4.003377966595758*^9}},
 CellLabel->
  "In[314]:=",ExpressionUUID->"61297fdd-6f42-4320-ae22-2b9ec749d89b"],

