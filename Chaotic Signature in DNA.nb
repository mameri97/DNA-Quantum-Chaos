Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"EXTRACT", " ", "ALL", " ", "ORBITAL", " ", "ENERGIES"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"readSpectrum", "[", "file_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"data", ",", "rows", ",", "energies"}], "}"}], ",", 
       RowBox[{
        RowBox[{"data", "=", 
         RowBox[{"Quiet", "@", 
          RowBox[{"Check", "[", 
           RowBox[{
            RowBox[{"Import", "[", 
             RowBox[{"file", ",", "\"\<CSV\>\""}], "]"}], ",", "$Failed"}], 
           "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"data", "===", "$Failed"}], "||", 
           RowBox[{"!", 
            RowBox[{"ListQ", "[", "data", "]"}]}], "||", 
           RowBox[{
            RowBox[{"Length", "[", "data", "]"}], "<", "2"}]}], ",", 
          RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rows", "=", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"Rest", "[", "data", "]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"ListQ", "[", "#", "]"}], "&&", 
             RowBox[{
              RowBox[{"Length", "[", "#", "]"}], "\[GreaterEqual]", "5"}], "&&", 
             RowBox[{"NumericQ", "[", 
              RowBox[{"#", "[", 
               RowBox[{"[", "5", "]"}], "]"}], "]"}]}], "&"}]}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"rows", "===", 
           RowBox[{"{", "}"}]}], ",", 
          RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"energies", "=", 
         RowBox[{"N", "[", 
          RowBox[{"rows", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "5"}], "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"VectorQ", "[", 
            RowBox[{"energies", ",", "NumericQ"}], "]"}]}], ",", 
          RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Sort", "[", "energies", "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"IMPORT", " ", "AT", " ", "AND", " ", "GC", " ", "SEPARATELY"}], 
    "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"atRawSpectra", "=", 
     RowBox[{"readSpectrum", "/@", "atFiles"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gcRawSpectra", "=", 
     RowBox[{"readSpectrum", "/@", "gcFiles"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "KEEP", " ", "ONLY", " ", "SUCCESSFULLY", " ", "IMPORTED", " ", 
     "SPECTRA"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"atSpectra", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"atRawSpectra", ",", "ListQ"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gcSpectra", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"gcRawSpectra", ",", "ListQ"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"COMBINE", " ", "THE", " ", "INDIVIDUAL", " ", "SPECTRA"}], 
    "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"spectra", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"atSpectra", ",", "gcSpectra"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Valid AT spectra: \>\"", ",", 
      RowBox[{"Length", "[", "atSpectra", "]"}]}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Valid GC spectra: \>\"", ",", 
      RowBox[{"Length", "[", "gcSpectra", "]"}]}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Total valid spectra: \>\"", ",", 
      RowBox[{"Length", "[", "spectra", "]"}]}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Orbital counts: \>\"", ",", 
      RowBox[{"Tally", "[", 
       RowBox[{"Length", "/@", "spectra"}], "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"spectra", "===", 
       RowBox[{"{", "}"}]}], ",", 
      RowBox[{"Abort", "[", "]"}]}], "]"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{4.0042395983435183`*^9, 4.0042395983505154`*^9}},
 CellLabel->
  "In[1904]:=",ExpressionUUID->"129a1562-9c2f-4e83-8f2a-189aa86fcad7"],

