Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"AT", " ", "DIRECTORY"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
    "atFolder", "=", 
     "\"\<C:\\\\Users\\\\Mehdi \
Ameri\\\\Desktop\\\\HB-Results\\\\AT\\\\Orbital Energy Levels\>\""}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"GC", " ", "DIRECTORY"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "gcFolder", "=", 
     "\"\<C:\\\\Users\\\\Mehdi \
Ameri\\\\Desktop\\\\HB-Results\\\\GC\\\\Orbital Energy Levels\>\""}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"CSV", " ", "FILE", " ", "PATTERN"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"filePattern", "=", "\"\<frame_*.csv\>\""}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "FIND", " ", "FILES", " ", "IN", " ", "EACH", " ", "DIRECTORY", " ", 
     "INDEPENDENTLY"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"atFiles", "=", 
     RowBox[{"Sort", "@", 
      RowBox[{"FileNames", "[", 
       RowBox[{"filePattern", ",", "atFolder"}], "]"}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gcFiles", "=", 
     RowBox[{"Sort", "@", 
      RowBox[{"FileNames", "[", 
       RowBox[{"filePattern", ",", "gcFolder"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"COMBINE", " ", "THE", " ", "TWO", " ", "FILE", " ", "LISTS"}], 
    "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"files", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"atFiles", ",", "gcFiles"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<AT files: \>\"", ",", 
      RowBox[{"Length", "[", "atFiles", "]"}]}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<GC files: \>\"", ",", 
      RowBox[{"Length", "[", "gcFiles", "]"}]}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Total files: \>\"", ",", 
      RowBox[{"Length", "[", "files", "]"}]}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"files", "===", 
       RowBox[{"{", "}"}]}], ",", 
      RowBox[{"Abort", "[", "]"}]}], "]"}], ";"}]}]}]], "Input",
