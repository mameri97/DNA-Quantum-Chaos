    RowBox[{"rawSpectra", "=", 
     RowBox[{"readSpectrum", "/@", "files"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"validMask", "=", 
     RowBox[{"ListQ", "/@", "rawSpectra"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"spectra", "=", 
     RowBox[{"Pick", "[", 
      RowBox[{"rawSpectra", ",", "validMask"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"validFiles", "=", 
     RowBox[{"Pick", "[", 
      RowBox[{"files", ",", "validMask"}], "]"}]}], ";"}], "\n", 
