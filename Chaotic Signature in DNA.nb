         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Rest", "[", "data", "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "5"}], "]"}], "]"}], ",", "NumericQ"}], 
          "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"file", ",", "filePaths"}], "}"}]}], "]"}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"CALCULATE", " ", "MINIMUM", " ", "AND", " ", "MAXIMUM"}], "*)"}],
