Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"PROBABILITY", " ", "DISTRIBUTIONS"}], "*)"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"pPoisson", "[", "s_", "]"}], ":=", 
     RowBox[{"Exp", "[", 
      RowBox[{"-", "s"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"pGOE", "[", "s_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"Pi", "/", "2"}], ")"}], "*", "s", "*", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "Pi"}], "*", 
        RowBox[{
         RowBox[{"s", "^", "2"}], "/", "4"}]}], "]"}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"pGUE", "[", "s_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"32", "/", 
        RowBox[{"Pi", "^", "2"}]}], ")"}], "*", 
      RowBox[{"s", "^", "2"}], "*", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "4"}], "*", 
        RowBox[{
         RowBox[{"s", "^", "2"}], "/", "Pi"}]}], "]"}]}]}], 
    ";"}]}]}]], "Input",
 CellLabel->
  "In[220]:=",ExpressionUUID->"743bb604-0bdf-4fa1-bf0f-8b7b2bbedeea"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"BRODY", " ", "DISTRIBUTION"}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"brodyB", "[", "beta_", "]"}], ":=", 
     RowBox[{
      RowBox[{"Gamma", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"beta", "+", "2"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"beta", "+", "1"}], ")"}]}], "]"}], "^", 
      RowBox[{"(", 
       RowBox[{"beta", "+", "1"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"pBrody", "[", 
      RowBox[{"s_", ",", "beta_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"beta", "+", "1"}], ")"}], "*", 
      RowBox[{"brodyB", "[", "beta", "]"}], "*", 
      RowBox[{"s", "^", "beta"}], "*", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"brodyB", "[", "beta", "]"}]}], "*", 
        RowBox[{"s", "^", 
         RowBox[{"(", 
          RowBox[{"beta", "+", "1"}], ")"}]}]}], "]"}]}]}], 
    ";"}]}]}]], "Input",
 CellLabel->
  "In[223]:=",ExpressionUUID->"4ea330fa-e775-4e04-918e-64f025be103a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "GAMMA", " ", "DISTRIBUTION", " ", "WITH", " ", "MEAN", " ", "FIXED", " ", 
    "TO", " ", "ONE"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"pGamma", "[", 
     RowBox[{"s_", ",", "a_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"a", "^", "a"}], "/", 
      RowBox[{"Gamma", "[", "a", "]"}]}], "*", 
     RowBox[{"s", "^", 
      RowBox[{"(", 
       RowBox[{"a", "-", "1"}], ")"}]}], "*", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "a"}], "*", "s"}], "]"}]}]}], ";"}]}]], "Input",
 CellLabel->
  "In[225]:=",ExpressionUUID->"0bf77282-9e08-4602-bef2-47ceadc7cf19"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"LOG", "-", "LIKELIHOODS"}], "*)"}], "\[IndentingNewLine]", "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"LLPoisson", "=", 
     RowBox[{"Total", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Log", "[", 
         RowBox[{"pPoisson", "[", "#", "]"}], "]"}], "&"}], "/@", "data"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"LLGOE", "=", 
     RowBox[{"Total", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Log", "[", 
         RowBox[{"pGOE", "[", "#", "]"}], "]"}], "&"}], "/@", "data"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"LLGUE", "=", 
     RowBox[{"Total", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Log", "[", 
         RowBox[{"pGUE", "[", "#", "]"}], "]"}], "&"}], "/@", "data"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"LLBrody", "[", 
      RowBox[{"beta_", "?", "NumericQ"}], "]"}], ":=", 
     RowBox[{"Total", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Log", "[", 
         RowBox[{"pBrody", "[", 
          RowBox[{"#", ",", "beta"}], "]"}], "]"}], "&"}], "/@", "data"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"LLGamma", "[", 
      RowBox[{"a_", "?", "NumericQ"}], "]"}], ":=", 
     RowBox[{"Total", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Log", "[", 
         RowBox[{"pGamma", "[", 
          RowBox[{"#", ",", "a"}], "]"}], "]"}], "&"}], "/@", "data"}], 
      "]"}]}], ";"}]}]}]], "Input",
 CellLabel->
  "In[226]:=",ExpressionUUID->"80b5c781-0ef3-45ae-90dd-3a817229a30c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Precalculate", " ", "quantities"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"sumLogS", "=", 
     RowBox[{"Total", "[", 
      RowBox[{"Log", "[", "data", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sumS", "=", 
     RowBox[{"Total", "[", "data", "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"BRODY", " ", "FIT"}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"brodyB", "[", "beta_", "]"}], ":=", 
     RowBox[{
      RowBox[{"Gamma", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"beta", "+", "2"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"beta", "+", "1"}], ")"}]}], "]"}], "^", 
      RowBox[{"(", 
       RowBox[{"beta", "+", "1"}], ")"}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"brodyLL", "[", 
      RowBox[{"beta_", "?", "NumericQ"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "b", "}"}], ",", 
       RowBox[{
        RowBox[{"b", "=", 
         RowBox[{"brodyB", "[", "beta", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"n", "*", 
          RowBox[{"Log", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"beta", "+", "1"}], ")"}], "*", "b"}], "]"}]}], "+", 
         RowBox[{"beta", "*", "sumLogS"}], "-", 
         RowBox[{"b", "*", 
          RowBox[{"Total", "[", 
           RowBox[{"data", "^", 
            RowBox[{"(", 
             RowBox[{"beta", "+", "1"}], ")"}]}], "]"}]}]}]}]}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"brodyFit", "=", 
     RowBox[{"NMaximize", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"brodyLL", "[", "beta", "]"}], ",", 
         RowBox[{"0", "\[LessEqual]", "beta", "\[LessEqual]", "1"}]}], "}"}], 
       ",", "beta", ",", 
       RowBox[{"Method", "\[Rule]", "\"\<NelderMead\>\""}]}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"betaBest", "=", 
     RowBox[{"beta", "/.", 
      RowBox[{"Last", "[", "brodyFit", "]"}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"GAMMA", " ", "FIT"}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"gammaLL", "[", 
      RowBox[{"a_", "?", "NumericQ"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"n", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"a", "*", 
          RowBox[{"Log", "[", "a", "]"}]}], "-", 
         RowBox[{"LogGamma", "[", "a", "]"}]}], ")"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"a", "-", "1"}], ")"}], "*", "sumLogS"}], "-", 
      RowBox[{"a", "*", "sumS"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gammaFit", "=", 
     RowBox[{"NMaximize", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"gammaLL", "[", "a", "]"}], ",", 
         RowBox[{"0.01", "\[LessEqual]", "a", "\[LessEqual]", "100"}]}], 
        "}"}], ",", "a", ",", 
       RowBox[{"Method", "\[Rule]", "\"\<NelderMead\>\""}]}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gammaBest", "=", 
     RowBox[{"a", "/.", 
      RowBox[{"Last", "[", "gammaFit", "]"}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", "RESULTS", "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Best Brody beta = \>\"", ",", 
      RowBox[{"N", "[", "betaBest", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Best Gamma shape = \>\"", ",", 
      RowBox[{"N", "[", "gammaBest", "]"}]}], "]"}], ";"}], "\n"}]}]], "Input",
