   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"BASIC", " ", "STATISTICS"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Maximum eigenvalue range (eV): \>\"", ",", 
      RowBox[{"MinMax", "[", "maxEigenvalues", "]"}]}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Minimum eigenvalue range (eV): \>\"", ",", 
      RowBox[{"MinMax", "[", "minEigenvalues", "]"}]}], "]"}], ";"}], 
   "\n"}]}]], "Input",
