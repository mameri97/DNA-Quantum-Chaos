          RowBox[{"Rest", "[", "importedData", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "4"}], "]"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sortedLevels", "=", 
        RowBox[{"Sort", "[", 
         RowBox[{"N", "[", 
          RowBox[{"DeleteCases", "[", 
           RowBox[{"rawEnergies", ",", 
            RowBox[{
