Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Perform", " ", "Spectral", " ", "Unfolding", " ", "via", " ", "KDE"}], 
   " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"nTotal", "=", 
     RowBox[{"Length", "[", "GSMainBothSorted", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"kdeDist", "=", 
     RowBox[{"SmoothKernelDistribution", "[", "GSMainBothSorted", "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Compute", " ", "smooth", " ", "cumulative", " ", "counting", " ", 
     "function", " ", "N_smooth", 
     RowBox[{"(", "E", ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"unfoldedLevels", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"nTotal", "*", 
        RowBox[{"CDF", "[", 
         RowBox[{"kdeDist", ",", "e"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"e", ",", "GSMainBothSorted"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Compute", " ", "Normalized", " ", "Spacings", " ", 
     RowBox[{"(", "s", ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"spacings", "=", 
     RowBox[{"Differences", "[", "unfoldedLevels", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"s", "=", 
     RowBox[{"spacings", "/", 
      RowBox[{"Mean", "[", "spacings", "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Filter", " ", "out", " ", "extreme", " ", "outliers", " ", "for", " ", 
     "a", " ", "clean", " ", "plot"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sClean", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"s", ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"#", ">", "0"}], "&&", 
          RowBox[{"#", "<", "4.0"}]}], ")"}], "&"}]}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{4.003043070099141*^9, 4.003043070105139*^9}, 
   4.0030432760887847`*^9, 4.0030434161244593`*^9, {4.003043450529843*^9, 
