Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"IMPORT", " ", "ALL", " ", "SPECTRA"}], "*)"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"rawSpectra", "=", 
     RowBox[{"readSpectrum", "/@", "files"}]}], ";"}], "\[IndentingNewLine]", 
