Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"ADJACENT", "-", 
    RowBox[{"GAP", " ", "RATIO", " ", "FOR", " ", "EACH", " ", "GEOMETRY"}]}],
    "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"ProcessRatios", "[", 
      RowBox[{"filePath_", ",", "type_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "data", ",", "rows", ",", "records", ",", "levels", ",", "gaps", ",", 
         "ratios"}], "}"}], ",", 
       RowBox[{
        RowBox[{"data", "=", 
         RowBox[{"Import", "[", 
          RowBox[{"filePath", ",", "\"\<Data\>\""}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "data", "]"}], "\[LessEqual]", "1"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"rows", "=", 
         RowBox[{"Rest", "[", "data", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"records", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"parseNum", "[", 
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", 
              RowBox[{"parseNum", "[", 
               RowBox[{"#", "[", 
                RowBox[{"[", "5", "]"}], "]"}], "]"}]}], "}"}], "&"}], ")"}], 
          "/@", 
          RowBox[{"Select", "[", 
           RowBox[{"rows", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "[", "#", "]"}], "\[GreaterEqual]", "5"}], 
             "&"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"records", "=", 
         RowBox[{"Select", "[", 
          RowBox[{"records", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"NumericQ", "[", 
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "]"}], "&&", 
             RowBox[{"NumericQ", "[", 
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "&"}]}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"levels", "=", 
         RowBox[{"Which", "[", 
          RowBox[{
           RowBox[{"type", "\[Equal]", "\"\<Occupied\>\""}], ",", 
           RowBox[{"Cases", "[", 
            RowBox[{"records", ",", 
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{"occ_", ",", "energy_"}], "}"}], "/;", 
               RowBox[{"occ", ">", "0"}]}], "\[RuleDelayed]", "energy"}]}], 
            "]"}], ",", 
           RowBox[{"type", "\[Equal]", "\"\<Virtual\>\""}], ",", 
           RowBox[{"Cases", "[", 
            RowBox[{"records", ",", 
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{"occ_", ",", "energy_"}], "}"}], "/;", 
               RowBox[{"occ", "\[Equal]", "0"}]}], "\[RuleDelayed]", 
              "energy"}]}], "]"}], ",", "True", ",", 
           RowBox[{"{", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"levels", "=", 
         RowBox[{"Sort", "[", 
          RowBox[{"N", "[", "levels", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "levels", "]"}], "<", "3"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"gaps", "=", 
         RowBox[{"Differences", "[", "levels", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"ratios", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Min", "[", "#", "]"}], "/", 
             RowBox[{"Max", "[", "#", "]"}]}], ")"}], "&"}], "/@", 
          RowBox[{"Partition", "[", 
           RowBox[{"gaps", ",", "2", ",", "1"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Select", "[", 
         RowBox[{"ratios", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"NumericQ", "[", "#", "]"}], "&&", 
            RowBox[{"0", "\[LessEqual]", "#", "\[LessEqual]", "1"}]}], 
           "&"}]}], "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"PROCESS", " ", "ALL", " ", "GEOMETRIES"}], "*)"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"OccupiedRatios", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"ParallelTable", "[", 
       RowBox[{
        RowBox[{"ProcessRatios", "[", 
         RowBox[{"file", ",", "\"\<Occupied\>\""}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"file", ",", "filePaths"}], "}"}]}], "]"}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"VirtualRatios", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"ParallelTable", "[", 
       RowBox[{
        RowBox[{"ProcessRatios", "[", 
         RowBox[{"file", ",", "\"\<Virtual\>\""}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"file", ",", "filePaths"}], "}"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
