Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"readSpectrum", "[", "file_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"data", ",", "rows", ",", "selectedRows", ",", "energies"}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{"data", "=", 
       RowBox[{"Quiet", "@", 
        RowBox[{"Check", "[", 
         RowBox[{
          RowBox[{"Import", "[", 
           RowBox[{"file", ",", "\"\<CSV\>\""}], "]"}], ",", "$Failed"}], 
         "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"data", "===", "$Failed"}], "||", 
         RowBox[{"!", 
          RowBox[{"ListQ", "[", "data", "]"}]}], "||", 
         RowBox[{
          RowBox[{"Length", "[", "data", "]"}], "<", "2"}]}], ",", 
        RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Remove", " ", "header", " ", "and", " ", "select", " ", "valid", " ", 
        "rows"}], "*)"}], 
      RowBox[{"rows", "=", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"Rest", "[", "data", "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"ListQ", "[", "#", "]"}], "&&", 
           RowBox[{
            RowBox[{"Length", "[", "#", "]"}], "\[GreaterEqual]", "5"}], "&&", 
           RowBox[{"NumericQ", "[", 
            RowBox[{"#", "[", 
             RowBox[{"[", "5", "]"}], "]"}], "]"}], "&&", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"orbitalSelection", "===", "\"\<All\>\""}], "||", 
             RowBox[{"NumericQ", "[", 
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ")"}]}], "&"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Select", " ", "occupied"}], ",", "virtual", ",", 
        RowBox[{"or", " ", "all", " ", "orbitals"}]}], "*)"}], 
      RowBox[{"selectedRows", "=", 
       RowBox[{"Switch", "[", 
        RowBox[{
        "orbitalSelection", ",", "\"\<All\>\"", ",", "rows", ",", 
         "\"\<Occupied\>\"", ",", 
         RowBox[{"Select", "[", 
          RowBox[{"rows", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ">", "0"}], "&"}]}], "]"}], 
         ",", "\"\<Virtual\>\"", ",", 
         RowBox[{"Select", "[", 
          RowBox[{"rows", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "\[Equal]", "0"}], "&"}]}], 
          "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"selectedRows", "===", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Extract", " ", "orbital", " ", "energies", " ", "in", " ", 
        RowBox[{"eV", ":", 
         RowBox[{"column", " ", "5"}]}]}], "*)"}], 
      RowBox[{"energies", "=", 
       RowBox[{"N", "[", 
        RowBox[{"selectedRows", "[", 
