Cell[CellGroupData[{

Cell[TextData[StyleBox["Find the fitting function for the combined plot ",
 FontSize->18,
 FontWeight->"Bold"]], "Subsection",
 CellChangeTimes->{{4.0033673126862316`*^9, 4.0033673133800683`*^9}, {
   4.0033710589132433`*^9, 4.003371070815115*^9}, {4.0033714910960484`*^9, 
   4.003371511450097*^9}, 
   4.0038302758705387`*^9},ExpressionUUID->"13942123-528b-491e-9127-\
075fc9cd5594"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "REGENERATE", " ", "ORIGINAL", " ", "COMBINED", " ", "SPACINGS", " ", 
    "WITHOUT", " ", "UPPER", " ", "CUTOFF"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"ProcessSingleFileFull", "[", "filePath_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "importedData", ",", "rawEnergies", ",", "sortedLevels", ",", 
         "nTotal", ",", "trimCount", ",", "coreLevels", ",", "nCore", ",", 
         "kdeDist", ",", "unfoldedLevels", ",", "spacings", ",", "meanS"}], 
        "}"}], ",", 
       RowBox[{
        RowBox[{"importedData", "=", 
         RowBox[{"Import", "[", 
          RowBox[{"filePath", ",", "\"\<Data\>\""}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "importedData", "]"}], "\[LessEqual]", 
           "1"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"rawEnergies", "=", 
         RowBox[{"ToExpression", "[", 
          RowBox[{
           RowBox[{"Rest", "[", "importedData", "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "5"}], "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"sortedLevels", "=", 
         RowBox[{"Sort", "[", 
          RowBox[{"N", "[", 
           RowBox[{"DeleteCases", "[", 
            RowBox[{"rawEnergies", ",", 
             RowBox[{
             "_Missing", "|", "Null", "|", "\"\<\>\"", "|", "_String"}]}], 
            "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"nTotal", "=", 
         RowBox[{"Length", "[", "sortedLevels", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"nTotal", "<", "20"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"trimCount", "=", 
         RowBox[{"Floor", "[", 
          RowBox[{"0.1", "*", "nTotal"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"coreLevels", "=", 
         RowBox[{"Take", "[", 
          RowBox[{"sortedLevels", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"trimCount", "+", "1"}], ",", 
             RowBox[{"nTotal", "-", "trimCount"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"nCore", "=", 
         RowBox[{"Length", "[", "coreLevels", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"nCore", "<", "10"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"kdeDist", "=", 
         RowBox[{"SmoothKernelDistribution", "[", "coreLevels", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"unfoldedLevels", "=", 
         RowBox[{"nCore", "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"CDF", "[", 
              RowBox[{"kdeDist", ",", "#"}], "]"}], "&"}], "/@", 
            "coreLevels"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"spacings", "=", 
         RowBox[{"Differences", "[", "unfoldedLevels", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "spacings", "]"}], "\[Equal]", "0"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"meanS", "=", 
         RowBox[{"Mean", "[", "spacings", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"!", 
            RowBox[{"NumberQ", "[", "meanS", "]"}]}], "||", 
           RowBox[{"meanS", "\[LessEqual]", "0"}]}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"spacings", "/", "meanS"}], ",", 
          RowBox[{
           RowBox[{"#", ">", "0"}], "&"}]}], "]"}]}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"AllSpacingsFull", "=", 
