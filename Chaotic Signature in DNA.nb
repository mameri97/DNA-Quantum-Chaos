Cell[BoxData[
 RowBox[{
  RowBox[{"getNormalizedSpacings", "[", "file_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"energies", ",", "spacings"}], "}"}], ",", 
    RowBox[{
     RowBox[{"energies", "=", 
      RowBox[{"Sort", "[", 
       RowBox[{"getEnergies", "[", "file", "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "energies", "]"}], "<", "2"}], ",", 
       RowBox[{"Return", "[", 
        RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"spacings", "=", 
      RowBox[{"Differences", "[", "energies", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Mean", "[", "spacings", "]"}], "\[LessEqual]", "0"}], ",", 
       RowBox[{"Return", "[", 
        RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"spacings", "/", 
      RowBox[{"Mean", "[", "spacings", "]"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{4.003214572632827*^9, 4.003214572638831*^9}},
 CellLabel->
  "In[732]:=",ExpressionUUID->"efc6eb58-cbcd-48cf-b2c5-741bf5c61f72"],

