       RowBox[{"[", 
        RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"PoissonDeviation", "=", 
   RowBox[{"Mean", "[", 
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{"empiricalCurve", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "2"}], "]"}], "]"}], "-", 
      RowBox[{"poissonCurve", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "]"}], "]"}]}], 
