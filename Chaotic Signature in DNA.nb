Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Generate", " ", "Customized", " ", "Plot"}], " ", "*)"}], "\n", 
  RowBox[{"GCMMOrbEnergyLinearUnf", "=", 
   RowBox[{"Histogram", "[", 
    RowBox[{"AllSpacingsLinear", ",", 
     RowBox[{"{", "0.05", "}"}], ",", "\"\<PDF\>\"", ",", 
     RowBox[{"ChartStyle", "\[Rule]", 
      RowBox[{"Directive", "[", 
       RowBox[{
        RowBox[{"RGBColor", "[", 
         RowBox[{"0.2", ",", "0.4", ",", "0.8"}], "]"}], ",", 
        RowBox[{"Opacity", "[", "0.6", "]"}]}], "]"}]}], ",", 
     RowBox[{"PlotRange", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "3.5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0.9"}], "}"}]}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Frame", "\[Rule]", "True"}], ",", "\[IndentingNewLine]", 
     RowBox[{"FrameStyle", "\[Rule]", 
      RowBox[{"Directive", "[", 
       RowBox[{
        RowBox[{"RGBColor", "[", 
         RowBox[{"0.1", ",", "0.1", ",", "0.1"}], "]"}], ",", 
        RowBox[{"Thickness", "[", "0.005", "]"}]}], "]"}]}], ",", 
     RowBox[{"BaseStyle", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"FontSize", "\[Rule]", "9"}], ",", 
        RowBox[{"FontFamily", "\[Rule]", "\"\<Arial\>\""}], ",", 
        RowBox[{"FontWeight", "\[Rule]", "Bold"}], ",", "Black"}], "}"}]}], 
     ",", 
     RowBox[{"FrameLabel", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{
         "\"\<normalized level-spacing s\>\"", ",", "10", ",", "Bold", ",", 
          RowBox[{"FontFamily", "\[Rule]", "\"\<Arial\>\""}], ",", "Black"}], 
         "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"Style", "[", 
         RowBox[{"\"\<P(s)\>\"", ",", "10", ",", "Bold", ",", 
          RowBox[{"FontFamily", "\[Rule]", "\"\<Arial\>\""}], ",", "Black"}], 
         "]"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"Epilog", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"Red", ",", 
           RowBox[{"Thickness", "[", "0.005", "]"}], ",", 
           RowBox[{
