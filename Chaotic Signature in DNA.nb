Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"5.", " ", "CUMULATIVE", " ", "DISTRIBUTION", " ", "COMPARISON"}], 
   "*)"}], "\[IndentingNewLine]", "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"empiricalCDF", "[", "data_List", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"sorted", ",", "n"}], "}"}], ",", 
       RowBox[{
        RowBox[{"sorted", "=", 
         RowBox[{"Sort", "[", "data", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"n", "=", 
         RowBox[{"Length", "[", "sorted", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Interpolation", "[", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"First", "[", "sorted", "]"}], "-", 
                RowBox[{"10", "^", 
                 RowBox[{"-", "8"}]}]}], ",", "0"}], "}"}], "}"}], ",", 
            RowBox[{"Transpose", "[", 
             RowBox[{"{", 
              RowBox[{"sorted", ",", 
               RowBox[{
                RowBox[{"Range", "[", "n", "]"}], "/", "n"}]}], "}"}], 
             "]"}]}], "]"}], ",", 
          RowBox[{"InterpolationOrder", "\[Rule]", "0"}]}], "]"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"MAXIMUM", " ", "EIGENVALUES"}], "*)"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"maxEmpCDF", "=", 
     RowBox[{"empiricalCDF", "[", "zMax", "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"maxCDFPlot", "=", 
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"maxEmpCDF", "[", "x", "]"}], ",", 
