Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"EXTRACT", " ", "ALL", " ", "ORBITAL", " ", "ENERGIES"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"readSpectrum", "[", "file_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"data", ",", "rows", ",", "energies"}], "}"}], ",", 
       RowBox[{
        RowBox[{"data", "=", 
         RowBox[{"Quiet", "@", 
          RowBox[{"Check", "[", 
           RowBox[{
            RowBox[{"Import", "[", 
             RowBox[{"file", ",", "\"\<CSV\>\""}], "]"}], ",", "$Failed"}], 
           "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"data", "===", "$Failed"}], "||", 
           RowBox[{"!", 
            RowBox[{"ListQ", "[", "data", "]"}]}], "||", 
           RowBox[{
            RowBox[{"Length", "[", "data", "]"}], "<", "2"}]}], ",", 
          RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rows", "=", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"Rest", "[", "data", "]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"ListQ", "[", "#", "]"}], "&&", 
             RowBox[{
              RowBox[{"Length", "[", "#", "]"}], "\[GreaterEqual]", "5"}], "&&", 
             RowBox[{"NumericQ", "[", 
              RowBox[{"#", "[", 
               RowBox[{"[", "5", "]"}], "]"}], "]"}]}], "&"}]}], "]"}]}], ";",
         "\[IndentingNewLine]", 
