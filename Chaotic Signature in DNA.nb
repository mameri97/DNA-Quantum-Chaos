     RowBox[{"FileNames", "[", 
      RowBox[{"\"\<frame_*.csv\>\"", ",", "folder"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Total files found: \>\"", ",", 
      RowBox[{"Length", "[", "filePaths", "]"}]}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"EXTRACT", " ", "ALL", " ", "ORBITAL", " ", "ENERGIES"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"allEnergies", "=", 
     RowBox[{"Flatten", "[", 
