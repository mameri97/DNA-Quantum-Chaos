Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"readSpectrum", "[", "file_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"data", ",", "rows", ",", "selectedRows", ",", "energies"}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{"data", "=", 
       RowBox[{"Quiet", "@", 
        RowBox[{"Check", "[", 
         RowBox[{
          RowBox[{"Import", "[", 
           RowBox[{"file", ",", "\"\<CSV\>\""}], "]"}], ",", "$Failed"}], 
         "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"data", "===", "$Failed"}], "||", 
         RowBox[{"!", 
          RowBox[{"ListQ", "[", "data", "]"}]}], "||", 
         RowBox[{
          RowBox[{"Length", "[", "data", "]"}], "<", "2"}]}], ",", 
        RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Remove", " ", "header", " ", "and", " ", "select", " ", "valid", " ", 
        "rows"}], "*)"}], 
      RowBox[{"rows", "=", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"Rest", "[", "data", "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"ListQ", "[", "#", "]"}], "&&", 
           RowBox[{
            RowBox[{"Length", "[", "#", "]"}], "\[GreaterEqual]", "5"}], "&&", 
           RowBox[{"NumericQ", "[", 
            RowBox[{"#", "[", 
             RowBox[{"[", "5", "]"}], "]"}], "]"}], "&&", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"orbitalSelection", "===", "\"\<All\>\""}], "||", 
             RowBox[{"NumericQ", "[", 
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ")"}]}], "&"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Select", " ", "occupied"}], ",", "virtual", ",", 
        RowBox[{"or", " ", "all", " ", "orbitals"}]}], "*)"}], 
      RowBox[{"selectedRows", "=", 
       RowBox[{"Switch", "[", 
        RowBox[{
        "orbitalSelection", ",", "\"\<All\>\"", ",", "rows", ",", 
         "\"\<Occupied\>\"", ",", 
         RowBox[{"Select", "[", 
          RowBox[{"rows", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ">", "0"}], "&"}]}], "]"}], 
         ",", "\"\<Virtual\>\"", ",", 
         RowBox[{"Select", "[", 
          RowBox[{"rows", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "\[Equal]", "0"}], "&"}]}], 
          "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"selectedRows", "===", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Extract", " ", "orbital", " ", "energies", " ", "in", " ", 
        RowBox[{"eV", ":", 
         RowBox[{"column", " ", "5"}]}]}], "*)"}], 
      RowBox[{"energies", "=", 
       RowBox[{"N", "[", 
        RowBox[{"selectedRows", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "5"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"VectorQ", "[", 
          RowBox[{"energies", ",", "NumericQ"}], "]"}]}], ",", 
        RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"VectorQ", "[", 
          RowBox[{"energies", ",", 
           RowBox[{
            RowBox[{"TrueQ", "[", 
             RowBox[{
              RowBox[{"Im", "[", "#", "]"}], "\[Equal]", "0"}], "]"}], 
            "&"}]}], "]"}]}], ",", 
        RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Sort", "[", 
       RowBox[{"Re", "[", "energies", "]"}], "]"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[1533]:=",ExpressionUUID->"35edf8f9-53cb-403f-91ff-0ea1fdc4631e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"IMPORT", " ", "ALL", " ", "SPECTRA"}], "*)"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"rawSpectra", "=", 
     RowBox[{"readSpectrum", "/@", "files"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"validMask", "=", 
     RowBox[{"ListQ", "/@", "rawSpectra"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"spectra", "=", 
     RowBox[{"Pick", "[", 
      RowBox[{"rawSpectra", ",", "validMask"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"validFiles", "=", 
     RowBox[{"Pick", "[", 
      RowBox[{"files", ",", "validMask"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Valid spectra: \>\"", ",", 
      RowBox[{"Length", "[", "spectra", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Invalid files: \>\"", ",", 
      RowBox[{
       RowBox[{"Length", "[", "files", "]"}], "-", 
       RowBox[{"Length", "[", "spectra", "]"}]}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"spectra", "===", 
       RowBox[{"{", "}"}]}], ",", 
      RowBox[{
       RowBox[{"Print", "[", "\"\<No valid spectra found.\>\"", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"CHECK", " ", "ORBITAL", " ", "COUNTS"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"spectrumLengths", "=", 
     RowBox[{"Length", "/@", "spectra"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Orbital counts: \>\"", ",", 
      RowBox[{"Tally", "[", "spectrumLengths", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", 
        RowBox[{"DeleteDuplicates", "[", "spectrumLengths", "]"}], "]"}], 
       "\[NotEqual]", "1"}], ",", 
      RowBox[{
       RowBox[{
       "Print", "[", 
        "\"\<Error: Different numbers of orbitals per geometry.\>\"", "]"}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nLevels", "=", 
     RowBox[{"First", "[", "spectrumLengths", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"nLevels", "<", "minLevels"}], ",", 
      RowBox[{
       RowBox[{
       "Print", "[", "\"\<Insufficient number of orbitals.\>\"", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Orbitals per geometry: \>\"", ",", "nLevels"}], "]"}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{4.004229135906105*^9, 4.004229146726015*^9}},
 CellLabel->
  "In[1534]:=",ExpressionUUID->"6b06a4d4-e02c-4d2d-9f8e-442467d39dd0"],

