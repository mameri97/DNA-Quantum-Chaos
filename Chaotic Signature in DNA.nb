 RowBox[{
  RowBox[{"(*", 
   RowBox[{"CSV", " ", "file", " ", "pattern"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"filePattern", "=", "\"\<multimode_sample_*.csv\>\""}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"orbitalSelection", "=", "\"\<All\>\""}], ";"}], "\n", 
   RowBox[{
    RowBox[{"kdeBandwidth", "=", "\"\<Silverman\>\""}], ";"}], 
   "\[IndentingNewLine]", 
