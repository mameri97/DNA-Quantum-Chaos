          RowBox[{"8", ",", "4"}], "}"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Poisson\>\"", ",", 
       RowBox[{"NumberForm", "[", 
        RowBox[{"PoissonDeviation", ",", 
         RowBox[{"{", 
