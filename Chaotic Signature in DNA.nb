Cell[CellGroupData[{

Cell[TextData[StyleBox["Tracy-Widom",
 FontWeight->"Bold"]], "Section",
 CellChangeTimes->{{4.00443301248099*^9, 
  4.0044330157049766`*^9}},ExpressionUUID->"fd8abaa1-37ed-4c1c-9a09-\
d390551d2f00"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"SELECT", " ", "THE", " ", 
    RowBox[{"DATASET", ":", 
     RowBox[{"AT", " ", "OR", " ", "GC"}]}]}], "*)"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"filePaths", "=", 
     RowBox[{"FileNames", "[", 
      RowBox[{
      "\"\<multimode_sample_*.csv\>\"", ",", 
       "\"\<C:\\\\Users\\\\Mehdi \
Ameri\\\\Desktop\\\\MM-Results\\\\GC\\\\Orbital Energy Levels\>\""}], "]"}]}],
     ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Total files found: \>\"", ",", 
      RowBox[{"Length", "[", "filePaths", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "EXTRACT", " ", "THE", " ", "ORIGINAL", " ", "ORBITAL", " ", "ENERGIES"}],
     "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"spectra", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"data", ",", "energies"}], "}"}], ",", 
         RowBox[{
          RowBox[{"data", "=", 
           RowBox[{"Import", "[", 
            RowBox[{"file", ",", "\"\<CSV\>\""}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"energies", "=", 
           RowBox[{"Cases", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Rest", "[", "data", "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "5"}], "]"}], "]"}], ",", 
             RowBox[{"_", "?", "NumericQ"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "energies", "]"}], ">", "0"}], ",", 
            "energies", ",", "$Failed"}], "]"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"file", ",", "filePaths"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"REMOVE", " ", "INVALID", " ", "FILES"}], "*)"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"validSpectra", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"spectra", ",", "ListQ"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Valid spectra: \>\"", ",", 
      RowBox[{"Length", "[", "validSpectra", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"EXTRACT", " ", "EXTREME", " ", "EIGENVALUES"}], "*)"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"maxEigenvalues", "=", 
     RowBox[{"Max", "/@", "validSpectra"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"minEigenvalues", "=", 
     RowBox[{"Min", "/@", "validSpectra"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Number of maximum eigenvalues: \>\"", ",", 
      RowBox[{"Length", "[", "maxEigenvalues", "]"}]}], "]"}], ";"}], "\n", 
