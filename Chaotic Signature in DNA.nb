Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Let", " ", "k"}], "=", 
     RowBox[{
      RowBox[{"2", " ", "and", " ", "lambda"}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"0.5", ".", "Then"}], " ", "the", " ", "equivalent", " ", 
         "Chi"}], "-", 
        RowBox[{"squared", " ", "has", " ", "nu"}]}], "=", 
       RowBox[{
        RowBox[{"2", "*", "2"}], "=", 
        RowBox[{"4", " ", "degrees", " ", "of", " ", "freedom"}]}]}]}]}], ",", 
    RowBox[{
     RowBox[{
     "and", " ", "its", " ", "rate", " ", "parameter", " ", "matches", " ", 
      "naturally", " ", "when", " ", "lambda"}], "=", "0.5"}]}], " ", "*)"}], 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"PDF", "[", 
        RowBox[{
         RowBox[{"ErlangDistribution", "[", 
          RowBox[{"2", ",", "0.5"}], "]"}], ",", "x"}], "]"}], ",", 
       RowBox[{"PDF", "[", 
        RowBox[{
         RowBox[{"ChiSquareDistribution", "[", "4", "]"}], ",", "x"}], 
        "]"}]}], "}"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "20"}], "}"}], ",", 
    RowBox[{"PlotStyle", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Directive", "[", 
        RowBox[{"Blue", ",", 
         RowBox[{"Thickness", "[", "0.02", "]"}]}], "]"}], ",", 
       RowBox[{"Directive", "[", 
        RowBox[{"Red", ",", "Dashed", ",", "Thick"}], "]"}]}], "}"}]}], ",", 
    RowBox[{"PlotLegends", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
      "\"\<ErlangDistribution[2, 0.5]\>\"", ",", 
       "\"\<ChiSquareDistribution[4]\>\""}], "}"}]}], ",", 
    RowBox[{"AxesLabel", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\"\<x\>\"", ",", "\"\<Density\>\""}], "}"}]}], ",", 
    RowBox[{
    "PlotLabel", "\[Rule]", "\"\<Direct Parameter-Matched Comparison\>\""}], 
    ",", 
    RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}]}]], "Input",
