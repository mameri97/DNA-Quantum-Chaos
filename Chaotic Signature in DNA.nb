Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Generate", " ", "Customized", " ", "Plot"}], " ", "*)"}], "\n", 
  RowBox[{"BothHBOrbEnergyKDEUnf", "=", 
   RowBox[{"Histogram", "[", 
    RowBox[{"AllSpacingsKDEBoth", ",", 
     RowBox[{"{", "0.05", "}"}], ",", "\"\<PDF\>\"", ",", 
     "\[IndentingNewLine]", 
     RowBox[{"ChartStyle", "\[Rule]", 
      RowBox[{"Directive", "[", 
       RowBox[{
        RowBox[{"RGBColor", "[", 
         RowBox[{"0.2", ",", "0.4", ",", "0.8"}], "]"}], ",", 
        RowBox[{"Opacity", "[", "0.6", "]"}]}], "]"}]}], ",", 
     RowBox[{"PlotRange", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
