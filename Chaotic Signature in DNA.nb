   "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"CSV", " ", "FILE", " ", "PATTERN"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"filePattern", "=", "\"\<multimode_sample_*.csv\>\""}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "FIND", " ", "FILES", " ", "IN", " ", "EACH", " ", "DIRECTORY", " ", 
     "INDEPENDENTLY"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
