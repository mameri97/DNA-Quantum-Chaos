Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Perform", " ", "Spectral", " ", "Unfolding", " ", "via", " ", "KDE"}], 
   " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"nTotal", "=", 
     RowBox[{"Length", "[", "GSMainATSorted", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"kdeDist", "=", 
     RowBox[{"SmoothKernelDistribution", "[", "GSMainATSorted", "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Compute", " ", "smooth", " ", "cumulative", " ", "counting", " ", 
     "function", " ", "N_smooth", 
     RowBox[{"(", "E", ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"unfoldedLevels", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"nTotal", "*", 
        RowBox[{"CDF", "[", 
         RowBox[{"kdeDist", ",", "e"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"e", ",", "GSMainATSorted"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Compute", " ", "Normalized", " ", "Spacings", " ", 
     RowBox[{"(", "s", ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"spacings", "=", 
     RowBox[{"Differences", "[", "unfoldedLevels", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"s", "=", 
     RowBox[{"spacings", "/", 
      RowBox[{"Mean", "[", "spacings", "]"}]}]}], ";"}], 
