Cell[CellGroupData[{

Cell[TextData[StyleBox["Separate Occupied and Virtual Orbitals",
 FontWeight->"Bold"]], "Subsection",
 CellChangeTimes->{{4.0033710258010135`*^9, 4.0033710505516715`*^9}, 
   4.0038301541334705`*^9},ExpressionUUID->"a5edcab6-fcce-4757-a11b-\
1b0ce1b8e25b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"FIND", " ", "ALL", " ", "CSV", " ", "FILES"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"filePaths", "=", 
     RowBox[{
     "FileNames", "[", 
      "\"\<C:\\\\Users\\\\Mehdi \
Ameri\\\\Desktop\\\\MM-Results\\\\AT\\\\Orbital Energy \
Levels\\\\multimode_sample_*.csv\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Total files found: \>\"", ",", 
      RowBox[{"Length", "[", "filePaths", "]"}]}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"ROBUST", " ", "NUMERICAL", " ", "CONVERSION"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"parseNum", "[", "x_", "]"}], ":=", 
     RowBox[{"Which", "[", 
      RowBox[{
       RowBox[{"NumberQ", "[", "x", "]"}], ",", 
       RowBox[{"N", "[", "x", "]"}], ",", 
       RowBox[{"StringQ", "[", "x", "]"}], ",", 
       RowBox[{"Quiet", "[", 
        RowBox[{"Check", "[", 
         RowBox[{
          RowBox[{"N", "[", 
           RowBox[{"ToExpression", "[", 
            RowBox[{"StringTrim", "[", "x", "]"}], "]"}], "]"}], ",", 
          "Indeterminate"}], "]"}], "]"}], ",", "True", ",", 
       "Indeterminate"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"PROCESS", " ", "ONE", " ", "SPECTRUM"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"ProcessOrbitals", "[", 
      RowBox[{"filePath_", ",", "type_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "data", ",", "rows", ",", "records", ",", "selectedLevels", ",", 
         "sortedLevels", ",", "nTotal", ",", "trimCount", ",", "coreLevels", 
         ",", "kdeDist", ",", "unfoldedLevels", ",", "spacings", ",", 
         "meanS"}], "}"}], ",", 
       RowBox[{
        RowBox[{"data", "=", 
         RowBox[{"Import", "[", 
          RowBox[{"filePath", ",", "\"\<Data\>\""}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "data", "]"}], "\[LessEqual]", "1"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"rows", "=", 
         RowBox[{"Rest", "[", "data", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Extract", " ", "occupation", " ", "and", " ", "energy", " ", 
          "together"}], "*)"}], 
        RowBox[{"records", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"parseNum", "[", 
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", 
              RowBox[{"parseNum", "[", 
               RowBox[{"#", "[", 
                RowBox[{"[", "5", "]"}], "]"}], "]"}]}], "}"}], "&"}], ")"}], 
          "/@", 
          RowBox[{"Select", "[", 
           RowBox[{"rows", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "[", "#", "]"}], "\[GreaterEqual]", "5"}], 
             "&"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Remove", " ", "invalid", " ", "entries"}], "*)"}], 
        RowBox[{"records", "=", 
         RowBox[{"Select", "[", 
          RowBox[{"records", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"NumericQ", "[", 
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "]"}], "&&", 
             RowBox[{"NumericQ", "[", 
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "&"}]}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Separate", " ", "occupied", " ", "and", " ", "virtual", " ", 
          "orbitals"}], "*)"}], 
        RowBox[{"selectedLevels", "=", 
         RowBox[{"Which", "[", 
          RowBox[{
           RowBox[{"type", "\[Equal]", "\"\<Occupied\>\""}], ",", 
           RowBox[{"Cases", "[", 
            RowBox[{"records", ",", 
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{"occ_", ",", "energy_"}], "}"}], "/;", 
               RowBox[{"occ", ">", "0"}]}], "\[RuleDelayed]", "energy"}]}], 
            "]"}], ",", 
           RowBox[{"type", "\[Equal]", "\"\<Virtual\>\""}], ",", 
           RowBox[{"Cases", "[", 
            RowBox[{"records", ",", 
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{"occ_", ",", "energy_"}], "}"}], "/;", 
               RowBox[{"occ", "\[Equal]", "0"}]}], "\[RuleDelayed]", 
              "energy"}]}], "]"}], ",", "True", ",", 
           RowBox[{"{", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"sortedLevels", "=", 
         RowBox[{"Sort", "[", 
          RowBox[{"N", "[", "selectedLevels", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"nTotal", "=", 
         RowBox[{"Length", "[", "sortedLevels", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"nTotal", "<", "20"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Remove", " ", "outer", " ", "10", " ", "percent"}], "*)"}], 
        RowBox[{"trimCount", "=", 
         RowBox[{"Floor", "[", 
          RowBox[{"0.1", "*", "nTotal"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"coreLevels", "=", 
         RowBox[{"Take", "[", 
          RowBox[{"sortedLevels", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"trimCount", "+", "1"}], ",", 
             RowBox[{"nTotal", "-", "trimCount"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "coreLevels", "]"}], "<", "10"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"KDE", " ", "unfolding"}], "*)"}], 
        RowBox[{"kdeDist", "=", 
         RowBox[{"SmoothKernelDistribution", "[", "coreLevels", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"unfoldedLevels", "=", 
         RowBox[{
          RowBox[{"Length", "[", "coreLevels", "]"}], "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"CDF", "[", 
              RowBox[{"kdeDist", ",", "#"}], "]"}], "&"}], "/@", 
            "coreLevels"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Calculate", " ", "normalized", " ", "spacings"}], "*)"}], 
        RowBox[{"spacings", "=", 
         RowBox[{"Differences", "[", "unfoldedLevels", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "spacings", "]"}], "\[Equal]", "0"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"meanS", "=", 
         RowBox[{"Mean", "[", "spacings", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"!", 
            RowBox[{"NumberQ", "[", "meanS", "]"}]}], "||", 
           RowBox[{"meanS", "\[LessEqual]", "0"}]}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"spacings", "/", "meanS"}]}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"PROCESS", " ", "ALL", " ", "FILES"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"AllOccupiedSpacings", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"ParallelTable", "[", 
       RowBox[{
        RowBox[{"ProcessOrbitals", "[", 
         RowBox[{"file", ",", "\"\<Occupied\>\""}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"file", ",", "filePaths"}], "}"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"AllVirtualSpacings", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"ParallelTable", "[", 
       RowBox[{
        RowBox[{"ProcessOrbitals", "[", 
         RowBox[{"file", ",", "\"\<Virtual\>\""}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"file", ",", "filePaths"}], "}"}]}], "]"}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"KEEP", " ", "ALL", " ", "POSITIVE", " ", "SPACINGS"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"AllOccupiedSpacings", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"AllOccupiedSpacings", ",", 
       RowBox[{
        RowBox[{"#", ">", "0"}], "&"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"AllVirtualSpacings", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"AllVirtualSpacings", ",", 
       RowBox[{
        RowBox[{"#", ">", "0"}], "&"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"DISPLAY", " ", "RESULTS"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Occupied spacings: \>\"", ",", 
      RowBox[{"Length", "[", "AllOccupiedSpacings", "]"}]}], "]"}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Virtual spacings: \>\"", ",", 
      RowBox[{"Length", "[", "AllVirtualSpacings", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", "AllOccupiedSpacings", "]"}], ">", "0"}], ",", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Mean occupied spacing: \>\"", ",", 
        RowBox[{"N", "[", 
         RowBox[{"Mean", "[", "AllOccupiedSpacings", "]"}], "]"}]}], "]"}]}], 
     "]"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", "AllVirtualSpacings", "]"}], ">", "0"}], ",", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Mean virtual spacing: \>\"", ",", 
        RowBox[{"N", "[", 
         RowBox[{"Mean", "[", "AllVirtualSpacings", "]"}], "]"}]}], "]"}]}], 
     "]"}], ";"}], "\n"}]}]], "Input",
 CellChangeTimes->{{4.003367879528064*^9, 4.0033678795340633`*^9}},
 CellLabel->
  "In[121]:=",ExpressionUUID->"a1437c78-c0ef-4f9f-aa99-97f70503e1e7"],

