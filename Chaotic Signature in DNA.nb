Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"zMax", "=", 
    RowBox[{"N", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"maxEigenvalues", "-", 
        RowBox[{"Mean", "[", "maxEigenvalues", "]"}]}], ")"}], "/", 
      RowBox[{"StandardDeviation", "[", "maxEigenvalues", "]"}]}], "]"}]}], 
   ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"reflectedMin", "=", 
    RowBox[{"-", "minEigenvalues"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"zMin", "=", 
    RowBox[{"N", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"reflectedMin", "-", 
        RowBox[{"Mean", "[", "reflectedMin", "]"}]}], ")"}], "/", 
      RowBox[{"StandardDeviation", "[", "reflectedMin", "]"}]}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"twStandardizedPDF", "[", "x_", "]"}], ":=", 
    RowBox[{"twSD", " ", 
     RowBox[{"PDF", "[", 
      RowBox[{"twDist", ",", 
       RowBox[{"twMean", "+", 
        RowBox[{"twSD", " ", "x"}]}]}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"twStandardizedCDF", "[", "x_", "]"}], ":=", 
   RowBox[{"CDF", "[", 
    RowBox[{"twDist", ",", 
     RowBox[{"twMean", "+", 
      RowBox[{"twSD", " ", "x"}]}]}], "]"}]}], ";"}], "\n"}], "Input",
 CellChangeTimes->{{4.0044330529760365`*^9, 4.0044330643935776`*^9}, {
  4.0044940788707423`*^9, 4.004494101201173*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"5caefc2e-af32-4f42-8d67-bf8308ec6d8b"],

