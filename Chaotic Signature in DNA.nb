Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"CSV", " ", "file", " ", "pattern"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"filePattern", "=", "\"\<frame_*.csv\>\""}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"orbitalSelection", "=", "\"\<All\>\""}], ";"}], "\n", 
   RowBox[{
    RowBox[{"kdeBandwidth", "=", "\"\<Silverman\>\""}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Lvalues", "=", 
     RowBox[{"Range", "[", 
      RowBox[{"0.5", ",", "20", ",", "0.5"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nStarts", "=", "150"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"edgeTrim", "=", "5"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"minLevels", "=", "50"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{4.004229062179904*^9, 4.00422907217863*^9}, {
  4.0042300275701523`*^9, 4.004230029190808*^9}, {4.004230375326125*^9, 
  4.0042303849201713`*^9}, {4.0042319338290343`*^9, 4.0042319350482135`*^9}, {
  4.00423212602448*^9, 4.0042321280932035`*^9}, {4.004232217936208*^9, 
  4.0042322367981234`*^9}},
 CellLabel->
  "In[1445]:=",ExpressionUUID->"e7e29744-1753-4dc0-b124-01edfc5d4447"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"folder", "=", 
   RowBox[{"SystemDialogInput", "[", "\"\<Directory\>\"", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"folder", "===", "$Canceled"}], ",", 
    RowBox[{"Abort", "[", "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"files", "=", 
   RowBox[{"Sort", "@", 
    RowBox[{"FileNames", "[", 
     RowBox[{"filePattern", ",", "folder"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Files found: \>\"", ",", 
    RowBox[{"Length", "[", "files", "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"files", "===", 
     RowBox[{"{", "}"}]}], ",", 
    RowBox[{
     RowBox[{
     "Print", "[", 
      "\"\<No CSV files found. Check the folder and file pattern.\>\"", "]"}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"!", 
     RowBox[{"MemberQ", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "\"\<All\>\"", ",", "\"\<Occupied\>\"", ",", "\"\<Virtual\>\""}], 
        "}"}], ",", "orbitalSelection"}], "]"}]}], ",", 
    RowBox[{
     RowBox[{"Print", "[", "\"\<Invalid orbital selection.\>\"", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], ";"}]}], "Input",
 CellLabel->
  "In[1452]:=",ExpressionUUID->"7a32355b-2ec9-4a63-9b7c-5946d32a64d1"],

