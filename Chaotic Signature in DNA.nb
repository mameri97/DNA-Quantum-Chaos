Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"COMBINED", " ", "PERCENTAGE", " ", "DEVIATIONS"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"combinedL", "=", 
     RowBox[{"combinedResults", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"combinedMean", "=", 
     RowBox[{"combinedResults", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"combinedPercentData", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"L", "=", 
            RowBox[{"combinedL", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], ",", 
           RowBox[{"empirical", "=", 
            RowBox[{"combinedMean", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"L", ",", 
           RowBox[{"100", " ", 
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"empirical", "-", 
               RowBox[{"sigmaPoisson", "[", "L", "]"}]}], "]"}], "/", 
             RowBox[{"sigmaPoisson", "[", "L", "]"}]}]}], ",", 
           RowBox[{"100", " ", 
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"empirical", "-", 
               RowBox[{"sigmaSemiPoisson", "[", "L", "]"}]}], "]"}], "/", 
             RowBox[{"sigmaSemiPoisson", "[", "L", "]"}]}]}], ",", 
           RowBox[{"100", " ", 
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"empirical", "-", 
               RowBox[{"sigmaGOE", "[", "L", "]"}]}], "]"}], "/", 
             RowBox[{"sigmaGOE", "[", "L", "]"}]}]}]}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "combinedL", "]"}]}], "}"}]}], "]"}]}], 
    ";"}]}]}]], "Input",
