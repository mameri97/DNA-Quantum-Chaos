Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"PDF", "[", 
       RowBox[{
        RowBox[{"ErlangDistribution", "[", 
         RowBox[{"k", ",", "0.5"}], "]"}], ",", "x"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "2", ",", "4", ",", "8"}], "}"}]}], "}"}]}], "]"}],
     "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "30"}], "}"}], ",", 
   RowBox[{"PlotLegends", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "\"\<k = 1 (Exponential)\>\"", ",", "\"\<k = 2\>\"", ",", 
      "\"\<k = 4\>\"", ",", "\"\<k = 8\>\""}], "}"}]}], ",", 
