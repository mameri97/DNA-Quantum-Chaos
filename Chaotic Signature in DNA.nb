       RowBox[{"{", 
        RowBox[{"L", ",", "Lvalues"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"GOECurve", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"L", ",", 
         RowBox[{"sigmaGOE", "[", "L", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"L", ",", "Lvalues"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Empirical", " ", "KDE", " ", "curve"}], "*)"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"empiricalCurve", "=", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"commonKDEResults", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "]"}], ",", 
       RowBox[{
        RowBox[{"NumericQ", "[", 
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "]"}], "&"}]}], "]"}]}], 
    ";"}]}]}]], "Input",
