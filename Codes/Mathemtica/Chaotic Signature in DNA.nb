Cell[CellGroupData[{

Cell[TextData[StyleBox["GC",
 FontWeight->"Bold"]], "Subsubsection",
 CellChangeTimes->{{4.0030509553420973`*^9, 4.0030509555530953`*^9}, 
   4.0034515674646387`*^9, 
   4.004569035502582*^9},ExpressionUUID->"d9887c1c-1f97-4311-a1d2-\
e709e94a7176"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"EXTRACT", " ", "ALL", " ", "ORBITAL", " ", "ENERGIES"}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"allEnergies", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"data", "=", 
          RowBox[{"Import", "[", 
           RowBox[{"file", ",", "\"\<CSV\>\""}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Rest", "[", "data", "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "5"}], "]"}], "]"}], ",", "NumericQ"}], 
          "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"file", ",", "GCMMfilePaths"}], "}"}]}], "]"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"CALCULATE", " ", "MINIMUM", " ", "AND", " ", "MAXIMUM"}], "*)"}],
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Total orbital energies: \>\"", ",", 
      RowBox[{"Length", "[", "allEnergies", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Minimum orbital energy (eV): \>\"", ",", 
      RowBox[{"Min", "[", "allEnergies", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Maximum orbital energy (eV): \>\"", ",", 
      RowBox[{"Max", "[", "allEnergies", "]"}]}], "]"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{4.004083632655281*^9, 4.0040836564371157`*^9}, {
  4.0042537269865484`*^9, 4.004253745024225*^9}, {4.0042538969591126`*^9, 
  4.004253898427644*^9}, {4.0045696983121605`*^9, 
  4.0045697059689703`*^9}},ExpressionUUID->"a37ca094-c72e-45a8-b529-\
6903e75ee73b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "PROCESS", " ", "ALL", " ", "FILES", " ", "IN", " ", "PARALLEL", " ", 
    "AND", " ", "FLATTEN"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"AllSpacingsKDE", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"ParallelTable", "[", 
       RowBox[{
        RowBox[{"ProcessSingleFile", "[", "file", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"file", ",", "GCMMfilePaths"}], "}"}]}], "]"}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{
     "\"\<Total pooled normalized spacings across all files: \>\"", ",", 
      RowBox[{"Length", "[", "AllSpacingsKDE", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Ensemble Mean Spacing: \>\"", ",", 
      RowBox[{"N", "[", 
