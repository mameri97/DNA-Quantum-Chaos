Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"CSV", " ", "file", " ", "pattern"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"filePattern", "=", "\"\<frame_*.csv\>\""}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"orbitalSelection", "=", "\"\<All\>\""}], ";"}], "\n", 
   RowBox[{
    RowBox[{"kdeBandwidth", "=", "\"\<Silverman\>\""}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Lvalues", "=", 
     RowBox[{"Range", "[", 
      RowBox[{"0.5", ",", "20", ",", "0.5"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nStarts", "=", "150"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"edgeTrim", "=", "5"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"minLevels", "=", "50"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{4.004229062179904*^9, 4.00422907217863*^9}, {
  4.0042300275701523`*^9, 4.004230029190808*^9}, {4.004230375326125*^9, 
