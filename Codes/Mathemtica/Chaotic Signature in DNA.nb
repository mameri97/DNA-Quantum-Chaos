Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"MEAN", " ", "ABSOLUTE", " ", "ERROR"}], "*)"}], " ", 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"GOEDeviation", "=", 
     RowBox[{"Mean", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"empiricalCurve", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}], "-", 
        RowBox[{"GOECurve", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"PoissonDeviation", "=", 
     RowBox[{"Mean", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"empiricalCurve", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}], "-", 
        RowBox[{"poissonCurve", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"SemiPoissonDeviation", "=", 
     RowBox[{"Mean", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"empiricalCurve", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}], "-", 
        RowBox[{"semiPoissonCurve", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"RESULTS", " ", "TABLE"}], "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<Ensemble\>\"", ",", "\"\<Mean Absolute Error\>\""}], 
        "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<GOE\>\"", ",", 
         RowBox[{"NumberForm", "[", 
          RowBox[{"GOEDeviation", ",", 
           RowBox[{"{", 
            RowBox[{"8", ",", "4"}], "}"}]}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<Poisson\>\"", ",", 
         RowBox[{"NumberForm", "[", 
          RowBox[{"PoissonDeviation", ",", 
           RowBox[{"{", 
            RowBox[{"8", ",", "4"}], "}"}]}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<Semi-Poisson\>\"", ",", 
         RowBox[{"NumberForm", "[", 
          RowBox[{"SemiPoissonDeviation", ",", 
           RowBox[{"{", 
            RowBox[{"8", ",", "4"}], "}"}]}], "]"}]}], "}"}]}], "}"}], ",", 
     RowBox[{"Frame", "\[Rule]", "All"}], ",", 
     RowBox[{"Alignment", "\[Rule]", "Center"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{4.004239839424847*^9, 4.0042398394318533`*^9}, {
  4.004571856086091*^9, 
  4.0045718651307755`*^9}},ExpressionUUID->"1c37c868-423e-4912-8b1b-\
8a26e321dc5e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"SPECTRAL", " ", "COMPRESSIBILITY"}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"fitLmin", "=", "5"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"fitLmax", "=", "20"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"spectralCompressibility", "[", "curve_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"points", ",", "fit"}], "}"}], ",", 
       RowBox[{
        RowBox[{"points", "=", 
         RowBox[{"Select", "[", 
          RowBox[{"curve", ",", 
           RowBox[{
            RowBox[{"fitLmin", "\[LessEqual]", 
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "\[LessEqual]", "fitLmax"}], 
            "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"fit", "=", 
         RowBox[{"Fit", "[", 
          RowBox[{"points", ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "x"}], "}"}], ",", "x"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Coefficient", "[", 
         RowBox[{"fit", ",", "x"}], "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"chiData", "=", 
     RowBox[{"spectralCompressibility", "[", "empiricalCurve", "]"}]}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"chiGOE", "=", 
     RowBox[{"spectralCompressibility", "[", "GOECurve", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"chiPoisson", "=", 
     RowBox[{"spectralCompressibility", "[", "poissonCurve", "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"chiSemiPoisson", "=", 
     RowBox[{"spectralCompressibility", "[", "semiPoissonCurve", "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "\"\<Ensemble\>\"", ",", 
         "\"\<Spectral compressibility (\[Chi])\>\""}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<Both MM\>\"", ",", 
         RowBox[{"NumberForm", "[", 
          RowBox[{"chiData", ",", 
           RowBox[{"{", 
            RowBox[{"6", ",", "4"}], "}"}]}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<GOE\>\"", ",", 
         RowBox[{"NumberForm", "[", 
          RowBox[{"chiGOE", ",", 
           RowBox[{"{", 
            RowBox[{"6", ",", "4"}], "}"}]}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<Poisson\>\"", ",", 
         RowBox[{"NumberForm", "[", 
          RowBox[{"chiPoisson", ",", 
           RowBox[{"{", 
            RowBox[{"6", ",", "4"}], "}"}]}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<Semi-Poisson\>\"", ",", 
         RowBox[{"NumberForm", "[", 
          RowBox[{"chiSemiPoisson", ",", 
           RowBox[{"{", 
            RowBox[{"6", ",", "4"}], "}"}]}], "]"}]}], "}"}]}], "}"}], ",", 
     RowBox[{"Frame", "\[Rule]", "All"}], ",", 
     RowBox[{"Alignment", "\[Rule]", "Center"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{4.0042414637870665`*^9, 4.004241484226514*^9}, {
  4.004241966873497*^9, 4.0042419909158936`*^9}, {4.0042424168758492`*^9, 
