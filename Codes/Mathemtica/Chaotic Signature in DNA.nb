Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"SPECTRAL", " ", "COMPRESSIBILITY"}], " ", "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"SELECT", " ", "LARGE"}], "-", 
    RowBox[{"L", " ", "FITTING", " ", "RANGE"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"fitLmin", "=", "5"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"fitLmax", "=", "20"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "FUNCTION", " ", "TO", " ", "CALCULATE", " ", "LINEAR", " ", "SLOPE"}], 
    " ", "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"spectralCompressibility", "[", "curve_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"points", ",", "fit"}], "}"}], ",", 
       RowBox[{
        RowBox[{"points", "=", 
         RowBox[{"Select", "[", 
          RowBox[{"curve", ",", 
           RowBox[{
            RowBox[{"fitLmin", "\[LessEqual]", 
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "\[LessEqual]", "fitLmax"}], 
            "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"fit", "=", 
         RowBox[{"Fit", "[", 
          RowBox[{"points", ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "x"}], "}"}], ",", "x"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Coefficient", "[", 
         RowBox[{"fit", ",", "x"}], "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"CALCULATE", " ", "SPECTRAL", " ", "COMPRESSIBILITY"}], " ", 
    "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"chiData", "=", 
     RowBox[{"spectralCompressibility", "[", "empiricalCurve", "]"}]}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"chiGOE", "=", 
     RowBox[{"spectralCompressibility", "[", "GOECurve", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"chiPoisson", "=", 
     RowBox[{"spectralCompressibility", "[", "poissonCurve", "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"chiSemiPoisson", "=", 
     RowBox[{"spectralCompressibility", "[", "semiPoissonCurve", "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"DISPLAY", " ", "RESULTS"}], " ", "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "\"\<Ensemble\>\"", ",", 
         "\"\<Spectral compressibility (\[Chi])\>\""}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<AT HB\>\"", ",", 
         RowBox[{"NumberForm", "[", 
          RowBox[{"chiData", ",", 
           RowBox[{"{", 
            RowBox[{"6", ",", "4"}], "}"}]}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<GOE\>\"", ",", 
         RowBox[{"NumberForm", "[", 
          RowBox[{"chiGOE", ",", 
           RowBox[{"{", 
            RowBox[{"6", ",", "4"}], "}"}]}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<Poisson\>\"", ",", 
         RowBox[{"NumberForm", "[", 
          RowBox[{"chiPoisson", ",", 
           RowBox[{"{", 
            RowBox[{"6", ",", "4"}], "}"}]}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<Semi-Poisson\>\"", ",", 
         RowBox[{"NumberForm", "[", 
          RowBox[{"chiSemiPoisson", ",", 
           RowBox[{"{", 
            RowBox[{"6", ",", "4"}], "}"}]}], "]"}]}], "}"}]}], "}"}], ",", 
     RowBox[{"Frame", "\[Rule]", "All"}], ",", 
     RowBox[{"Alignment", "\[Rule]", "Center"}]}], "]"}]}]}]], "Input",
