Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"EXTRACT", " ", "ALL", " ", "ORBITAL", " ", "ENERGIES"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"readSpectrum", "[", "file_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"data", ",", "rows", ",", "energies"}], "}"}], ",", 
       RowBox[{
        RowBox[{"data", "=", 
         RowBox[{"Quiet", "@", 
          RowBox[{"Check", "[", 
           RowBox[{
            RowBox[{"Import", "[", 
             RowBox[{"file", ",", "\"\<CSV\>\""}], "]"}], ",", "$Failed"}], 
           "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"data", "===", "$Failed"}], "||", 
           RowBox[{"!", 
            RowBox[{"ListQ", "[", "data", "]"}]}], "||", 
           RowBox[{
            RowBox[{"Length", "[", "data", "]"}], "<", "2"}]}], ",", 
          RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rows", "=", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"Rest", "[", "data", "]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"ListQ", "[", "#", "]"}], "&&", 
             RowBox[{
              RowBox[{"Length", "[", "#", "]"}], "\[GreaterEqual]", "5"}], "&&", 
             RowBox[{"NumericQ", "[", 
              RowBox[{"#", "[", 
               RowBox[{"[", "5", "]"}], "]"}], "]"}]}], "&"}]}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"rows", "===", 
           RowBox[{"{", "}"}]}], ",", 
          RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"energies", "=", 
         RowBox[{"N", "[", 
          RowBox[{"rows", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "5"}], "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"VectorQ", "[", 
            RowBox[{"energies", ",", "NumericQ"}], "]"}]}], ",", 
          RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Sort", "[", "energies", "]"}]}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"IMPORT", " ", "AT", " ", "AND", " ", "GC", " ", "SEPARATELY"}], 
    "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"atRawSpectra", "=", 
     RowBox[{"readSpectrum", "/@", "atFiles"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gcRawSpectra", "=", 
     RowBox[{"readSpectrum", "/@", "gcFiles"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "KEEP", " ", "ONLY", " ", "SUCCESSFULLY", " ", "IMPORTED", " ", 
     "SPECTRA"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"atSpectra", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"atRawSpectra", ",", "ListQ"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gcSpectra", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"gcRawSpectra", ",", "ListQ"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"COMBINE", " ", "THE", " ", "INDIVIDUAL", " ", "SPECTRA"}], 
    "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"spectra", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"atSpectra", ",", "gcSpectra"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Valid AT spectra: \>\"", ",", 
      RowBox[{"Length", "[", "atSpectra", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Valid GC spectra: \>\"", ",", 
      RowBox[{"Length", "[", "gcSpectra", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Total valid spectra: \>\"", ",", 
      RowBox[{"Length", "[", "spectra", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Orbital counts: \>\"", ",", 
      RowBox[{"Tally", "[", 
       RowBox[{"Length", "/@", "spectra"}], "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"spectra", "===", 
       RowBox[{"{", "}"}]}], ",", 
      RowBox[{"Abort", "[", "]"}]}], "]"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{4.0042395983435183`*^9, 4.0042395983505154`*^9}, {
   4.004571789696278*^9, 4.004571797045089*^9}, 
   4.0045719216727433`*^9},ExpressionUUID->"f1d19900-8661-4ad8-99ea-\
0366d54ca6d3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "POOL", " ", "ALL", " ", "AT", " ", "AND", " ", "GC", " ", "ENERGIES"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"allEnergies", "=", 
     RowBox[{"Flatten", "[", "spectra", "]"}]}], ";"}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "AVERAGE", " ", "NUMBER", " ", "OF", " ", "ORBITALS", " ", "PER", " ", 
     "GEOMETRY"}], "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"meanLevels", "=", 
     RowBox[{"Mean", "[", 
      RowBox[{"Length", "/@", "spectra"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"COMMON", " ", "ENSEMBLE", " ", "KDE"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"kdeBandwidth", "=", "\"\<Silverman\>\""}], ";"}], "\n", 
   RowBox[{
    RowBox[{"commonKDE", "=", 
     RowBox[{"SmoothKernelDistribution", "[", 
      RowBox[{"allEnergies", ",", "kdeBandwidth"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "APPLY", " ", "THE", " ", "SAME", " ", "UNFOLDING", " ", "FUNCTION", " ", 
     "TO", " ", "EVERY", " ", "SPECTRUM"}], "*)"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"unfoldingFunction", "[", 
      RowBox[{"E_", "?", "NumericQ"}], "]"}], ":=", 
     RowBox[{"meanLevels", " ", 
      RowBox[{"CDF", "[", 
       RowBox[{"commonKDE", ",", "E"}], "]"}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "PRESERVE", " ", "INDIVIDUAL", " ", "GEOMETRY", " ", "BOUNDARIES"}], 
    "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"unfoldedSpectra", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"unfoldingFunction", "/@", "#"}], ")"}], "&"}], "/@", 
      "spectra"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Combined AT + GC unfolding completed.\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Total geometries: \>\"", ",", 
      RowBox[{"Length", "[", "unfoldedSpectra", "]"}]}], "]"}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{4.0042396041058006`*^9, 4.0042396041127768`*^9}, 
   4.004239651909295*^9, {4.0045719128068867`*^9, 
