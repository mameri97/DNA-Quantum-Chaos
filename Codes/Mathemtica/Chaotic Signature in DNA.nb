    RowBox[{"Print", "[", 
     RowBox[{
     "\"\<Total pooled normalized spacings across all files: \>\"", ",", 
      RowBox[{"Length", "[", "AllSpacingsKDEBoth", "]"}]}], "]"}], ";"}], 
