935d59491efe"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"THEORETICAL", " ", "NUMBER", " ", "VARIANCE", " ", "CURVES"}], 
   " ", "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Generate", " ", "theoretical", " ", "curves"}], " ", "*)"}], "\n",
   "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"poissonCurve", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"L", ",", 
         RowBox[{"sigmaPoisson", "[", "L", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"L", ",", "Lvalues"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"semiPoissonCurve", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"L", ",", 
         RowBox[{"sigmaSemiPoisson", "[", "L", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"L", ",", "Lvalues"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"GOECurve", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"L", ",", 
         RowBox[{"sigmaGOE", "[", "L", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"L", ",", "Lvalues"}], "}"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Empirical", " ", "KDE", " ", "curve"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"empiricalCurve", "=", 
     RowBox[{"Select", "[", 
