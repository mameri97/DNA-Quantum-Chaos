Cell[BoxData[{
 RowBox[{
  RowBox[{"GOEDeviation", "=", 
   RowBox[{"Mean", "[", 
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{"empiricalCurve", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "2"}], "]"}], "]"}], "-", 
      RowBox[{"GOECurve", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"PoissonDeviation", "=", 
   RowBox[{"Mean", "[", 
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{"empiricalCurve", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "2"}], "]"}], "]"}], "-", 
      RowBox[{"poissonCurve", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SemiPoissonDeviation", "=", 
    RowBox[{"Mean", "[", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"empiricalCurve", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "2"}], "]"}], "]"}], "-", 
       RowBox[{"semiPoissonCurve", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"RESULTS", " ", "TABLE"}], "*)"}]}], "\n", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<Ensemble\>\"", ",", "\"\<Mean Absolute Error\>\""}], "}"}],
      ",", 
     RowBox[{"{", 
      RowBox[{"\"\<GOE\>\"", ",", 
       RowBox[{"NumberForm", "[", 
        RowBox[{"GOEDeviation", ",", 
         RowBox[{"{", 
          RowBox[{"8", ",", "4"}], "}"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Poisson\>\"", ",", 
