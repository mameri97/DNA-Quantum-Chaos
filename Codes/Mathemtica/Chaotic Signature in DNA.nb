Cell[BoxData[{
 RowBox[{
  RowBox[{"folder", "=", 
   RowBox[{"SystemDialogInput", "[", "\"\<Directory\>\"", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"folder", "===", "$Canceled"}], ",", 
