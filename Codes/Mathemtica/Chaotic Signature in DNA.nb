  RowBox[{"folder", "=", 
   RowBox[{"SystemDialogInput", "[", "\"\<Directory\>\"", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"folder", "===", "$Canceled"}], ",", 
    RowBox[{"Abort", "[", "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"files", "=", 
   RowBox[{"Sort", "@", 
    RowBox[{"FileNames", "[", 
