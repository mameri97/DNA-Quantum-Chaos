Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "  ", 
   RowBox[{"NUMBER", " ", 
    RowBox[{"VARIANCE", ":", " ", 
     RowBox[{"INTERVAL", " ", "COUNTING"}]}]}], " ", "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{" ", 
    RowBox[{"Count", " ", "levels", " ", "in", " ", 
     RowBox[{"intervals", "[", 
      RowBox[{"x", ",", 
       RowBox[{"x", "+", "L"}]}]}]}], ")"}], "*)"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"intervalCounts", "[", 
      RowBox[{"levels_List", ",", "starts_List", ",", 
       RowBox[{"len_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"n", "=", 
          RowBox[{"Length", "[", "levels", "]"}]}], ",", 
         RowBox[{"left", "=", "1"}], ",", 
         RowBox[{"right", "=", "1"}], ",", 
         RowBox[{"counts", "=", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0", ",", 
            RowBox[{"Length", "[", "starts", "]"}]}], "]"}]}], ",", "t"}], 
        "}"}], ",", 
       RowBox[{
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"t", "=", 
            RowBox[{"starts", "[", 
             RowBox[{"[", "j", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"While", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"left", "\[LessEqual]", "n"}], "&&", 
              RowBox[{
               RowBox[{"levels", "[", 
                RowBox[{"[", "left", "]"}], "]"}], "<", "t"}]}], ",", 
             RowBox[{"left", "++"}]}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"right", "<", "left"}], ",", 
             RowBox[{"right", "=", "left"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"While", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"right", "\[LessEqual]", "n"}], "&&", 
              RowBox[{
               RowBox[{"levels", "[", 
                RowBox[{"[", "right", "]"}], "]"}], "<", 
               RowBox[{"t", "+", "len"}]}]}], ",", 
             RowBox[{"right", "++"}]}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"counts", "[", 
             RowBox[{"[", "j", "]"}], "]"}], "=", 
            RowBox[{"right", "-", "left"}]}], ";"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", 
            RowBox[{"Length", "[", "starts", "]"}]}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", "counts"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Number", " ", "variance", " ", "for", " ", "one", " ", "geometry"}], 
    "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"numberVarianceOne", "[", 
      RowBox[{"levels_List", ",", 
       RowBox[{"L_", "?", "NumericQ"}], ",", "nStarts_Integer", ",", 
       RowBox[{"edgeTrim_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"u", ",", "tMin", ",", "tMax", ",", "starts", ",", "counts"}],
         "}"}], ",", 
       RowBox[{
        RowBox[{"u", "=", 
         RowBox[{"Sort", "[", 
          RowBox[{"N", "[", "levels", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "u", "]"}], "<", "2"}], "||", 
           RowBox[{"L", "\[LessEqual]", "0"}]}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"Missing", "[", "\"\<Invalid\>\"", "]"}], "]"}]}], "]"}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Remove", " ", "edge", " ", "regions"}], "*)"}], 
        RowBox[{"tMin", "=", 
         RowBox[{
          RowBox[{"First", "[", "u", "]"}], "+", "edgeTrim"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"tMax", "=", 
         RowBox[{
          RowBox[{"Last", "[", "u", "]"}], "-", "L", "-", "edgeTrim"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"tMax", "\[LessEqual]", "tMin"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"Missing", "[", "\"\<TooShort\>\"", "]"}], "]"}]}], "]"}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Generate", " ", "equally", " ", "spaced", " ", "window", " ", 
          "positions"}], "*)"}], 
        RowBox[{"starts", "=", 
         RowBox[{"N", "[", 
          RowBox[{"Subdivide", "[", 
           RowBox[{"tMin", ",", "tMax", ",", "nStarts"}], "]"}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Count", " ", "levels", " ", "in", " ", "all", " ", "windows"}], 
         "*)"}], 
        RowBox[{"counts", "=", 
         RowBox[{"intervalCounts", "[", 
          RowBox[{"u", ",", "starts", ",", "L"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Calculate", " ", "number", " ", "variance"}], "*)"}], 
        RowBox[{"Mean", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"counts", "-", "L"}], ")"}], "^", "2"}], "]"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"ENSEMBLE", " ", "AVERAGING"}], " ", "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"numberVarianceEnsemble", "[", 
      RowBox[{"unfolded_List", ",", "Lvals_List", ",", "nStarts_Integer", ",", 
       RowBox[{"edgeTrim_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", "vals", "}"}], ",", 
         RowBox[{
          RowBox[{"vals", "=", 
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"numberVarianceOne", "[", 
                RowBox[{"#", ",", "ell", ",", "nStarts", ",", "edgeTrim"}], 
                "]"}], "&"}], "/@", "unfolded"}], ",", "NumericQ"}], "]"}]}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "vals", "]"}], "\[GreaterEqual]", "2"}], 
            ",", 
            RowBox[{"{", 
             RowBox[{"ell", ",", 
              RowBox[{"Mean", "[", "vals", "]"}], ",", 
              RowBox[{
               RowBox[{"StandardDeviation", "[", "vals", "]"}], "/", 
               RowBox[{"Sqrt", "[", 
                RowBox[{"Length", "[", "vals", "]"}], "]"}]}], ",", 
              RowBox[{"Length", "[", "vals", "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"ell", ",", "Indeterminate", ",", "Indeterminate", ",", 
              RowBox[{"Length", "[", "vals", "]"}]}], "}"}]}], "]"}]}]}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"ell", ",", "Lvals"}], "}"}]}], "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{4.004570873843685*^9, 4.0045709262560587`*^9}, {
