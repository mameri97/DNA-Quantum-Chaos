   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<Ensemble\>\"", ",", "\"\<Mean Absolute Error\>\""}], "}"}],
      ",", 
     RowBox[{"{", 
      RowBox[{"\"\<GOE\>\"", ",", 
       RowBox[{"NumberForm", "[", 
        RowBox[{"GOEDeviation", ",", 
         RowBox[{"{", 
          RowBox[{"8", ",", "4"}], "}"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Poisson\>\"", ",", 
