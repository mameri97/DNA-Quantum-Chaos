Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"AT", " ", "DIRECTORY"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"atFolder", "=", "\"\<AT-MM Directory\>\""}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"GC", " ", "DIRECTORY"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gcFolder", "=", "\"\<GC-MM Directory\>\""}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"CSV", " ", "FILE", " ", "PATTERN"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"filePattern", "=", "\"\<multimode_sample_*.csv\>\""}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "FIND", " ", "FILES", " ", "IN", " ", "EACH", " ", "DIRECTORY", " ", 
     "INDEPENDENTLY"}], "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"atFiles", "=", 
     RowBox[{"Sort", "@", 
      RowBox[{"FileNames", "[", 
       RowBox[{"filePattern", ",", "atFolder"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gcFiles", "=", 
     RowBox[{"Sort", "@", 
      RowBox[{"FileNames", "[", 
       RowBox[{"filePattern", ",", "gcFolder"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"COMBINE", " ", "THE", " ", "TWO", " ", "FILE", " ", "LISTS"}], 
    "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"files", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"atFiles", ",", "gcFiles"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<AT files: \>\"", ",", 
      RowBox[{"Length", "[", "atFiles", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<GC files: \>\"", ",", 
      RowBox[{"Length", "[", "gcFiles", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Total files: \>\"", ",", 
      RowBox[{"Length", "[", "files", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
