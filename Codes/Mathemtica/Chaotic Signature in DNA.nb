Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"EXTRACT", " ", "ALL", " ", "ORBITAL", " ", "ENERGIES"}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"allEnergies", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"data", "=", 
          RowBox[{"Import", "[", 
           RowBox[{"file", ",", "\"\<CSV\>\""}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Rest", "[", "data", "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "5"}], "]"}], "]"}], ",", "NumericQ"}], 
          "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"file", ",", "ATMMfilePaths"}], "}"}]}], "]"}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"CALCULATE", " ", "MINIMUM", " ", "AND", " ", "MAXIMUM"}], "*)"}],
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Total orbital energies: \>\"", ",", 
      RowBox[{"Length", "[", "allEnergies", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Minimum orbital energy (eV): \>\"", ",", 
      RowBox[{"Min", "[", "allEnergies", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Maximum orbital energy (eV): \>\"", ",", 
      RowBox[{"Max", "[", "allEnergies", "]"}]}], "]"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{4.004083632655281*^9, 4.0040836564371157`*^9}, {
  4.0042537269865484`*^9, 4.004253745024225*^9}, {4.0045696391583366`*^9, 
  4.0045696425186195`*^9}, {4.0045702025237846`*^9, 
  4.004570214528487*^9}},ExpressionUUID->"9cd73074-7f70-4ee8-821c-\
a9eb4dd18aaa"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "PROCESS", " ", "ALL", " ", "FILES", " ", "IN", " ", "PARALLEL", " ", 
    "AND", " ", "FLATTEN"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"AllSpacingsKDE", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"ParallelTable", "[", 
       RowBox[{
        RowBox[{"ProcessSingleFile", "[", "file", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"file", ",", "ATMMfilePaths"}], "}"}]}], "]"}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{
     "\"\<Total pooled normalized spacings across all files: \>\"", ",", 
      RowBox[{"Length", "[", "AllSpacingsKDE", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Ensemble Mean Spacing: \>\"", ",", 
      RowBox[{"N", "[", 
       RowBox[{"Mean", "[", "AllSpacingsKDE", "]"}], "]"}]}], "]"}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{4.003196723437789*^9, 4.003196727205387*^9}, {
   4.003205843446483*^9, 4.0032058567184925`*^9}, 
