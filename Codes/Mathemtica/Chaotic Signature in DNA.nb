Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"readSpectrum", "[", "file_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"data", ",", "rows", ",", "selectedRows", ",", "energies"}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{"data", "=", 
       RowBox[{"Quiet", "@", 
        RowBox[{"Check", "[", 
         RowBox[{
          RowBox[{"Import", "[", 
           RowBox[{"file", ",", "\"\<CSV\>\""}], "]"}], ",", "$Failed"}], 
         "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"data", "===", "$Failed"}], "||", 
         RowBox[{"!", 
          RowBox[{"ListQ", "[", "data", "]"}]}], "||", 
         RowBox[{
          RowBox[{"Length", "[", "data", "]"}], "<", "2"}]}], ",", 
        RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Remove", " ", "header", " ", "and", " ", "select", " ", "valid", " ", 
        "rows"}], "*)"}], 
      RowBox[{"rows", "=", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"Rest", "[", "data", "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"ListQ", "[", "#", "]"}], "&&", 
           RowBox[{
            RowBox[{"Length", "[", "#", "]"}], "\[GreaterEqual]", "5"}], "&&", 
           RowBox[{"NumericQ", "[", 
            RowBox[{"#", "[", 
             RowBox[{"[", "5", "]"}], "]"}], "]"}], "&&", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"orbitalSelection", "===", "\"\<All\>\""}], "||", 
             RowBox[{"NumericQ", "[", 
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ")"}]}], "&"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Select", " ", "occupied"}], ",", "virtual", ",", 
        RowBox[{"or", " ", "all", " ", "orbitals"}]}], "*)"}], 
      RowBox[{"selectedRows", "=", 
       RowBox[{"Switch", "[", 
        RowBox[{
        "orbitalSelection", ",", "\"\<All\>\"", ",", "rows", ",", 
         "\"\<Occupied\>\"", ",", 
         RowBox[{"Select", "[", 
          RowBox[{"rows", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ">", "0"}], "&"}]}], "]"}], 
         ",", "\"\<Virtual\>\"", ",", 
         RowBox[{"Select", "[", 
          RowBox[{"rows", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "\[Equal]", "0"}], "&"}]}], 
          "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"selectedRows", "===", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Extract", " ", "orbital", " ", "energies", " ", "in", " ", 
        RowBox[{"eV", ":", 
         RowBox[{"column", " ", "5"}]}]}], "*)"}], 
      RowBox[{"energies", "=", 
       RowBox[{"N", "[", 
        RowBox[{"selectedRows", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "5"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"VectorQ", "[", 
          RowBox[{"energies", ",", "NumericQ"}], "]"}]}], ",", 
        RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"VectorQ", "[", 
          RowBox[{"energies", ",", 
           RowBox[{
            RowBox[{"TrueQ", "[", 
             RowBox[{
              RowBox[{"Im", "[", "#", "]"}], "\[Equal]", "0"}], "]"}], 
            "&"}]}], "]"}]}], ",", 
        RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Sort", "[", 
       RowBox[{"Re", "[", "energies", "]"}], "]"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[1675]:=",ExpressionUUID->"8c645e31-3b4c-4a13-be7f-cf3b294588d5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"IMPORT", " ", "ALL", " ", "SPECTRA"}], " ", "*)"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"rawSpectra", "=", 
     RowBox[{"readSpectrum", "/@", "files"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"validMask", "=", 
     RowBox[{"ListQ", "/@", "rawSpectra"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"spectra", "=", 
     RowBox[{"Pick", "[", 
      RowBox[{"rawSpectra", ",", "validMask"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"validFiles", "=", 
     RowBox[{"Pick", "[", 
      RowBox[{"files", ",", "validMask"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Valid spectra: \>\"", ",", 
      RowBox[{"Length", "[", "spectra", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Invalid files: \>\"", ",", 
      RowBox[{
       RowBox[{"Length", "[", "files", "]"}], "-", 
       RowBox[{"Length", "[", "spectra", "]"}]}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"spectra", "===", 
       RowBox[{"{", "}"}]}], ",", 
      RowBox[{
       RowBox[{"Print", "[", "\"\<No valid spectra found.\>\"", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"CHECK", " ", "ORBITAL", " ", "COUNTS"}], "*)"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"spectrumLengths", "=", 
     RowBox[{"Length", "/@", "spectra"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Orbital counts: \>\"", ",", 
      RowBox[{"Tally", "[", "spectrumLengths", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", 
        RowBox[{"DeleteDuplicates", "[", "spectrumLengths", "]"}], "]"}], 
       "\[NotEqual]", "1"}], ",", 
      RowBox[{
       RowBox[{
       "Print", "[", 
        "\"\<Error: Different numbers of orbitals per geometry.\>\"", "]"}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nLevels", "=", 
     RowBox[{"First", "[", "spectrumLengths", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"nLevels", "<", "minLevels"}], ",", 
      RowBox[{
       RowBox[{
       "Print", "[", "\"\<Insufficient number of orbitals.\>\"", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Orbitals per geometry: \>\"", ",", "nLevels"}], "]"}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{4.004229135906105*^9, 4.004229146726015*^9}, {
  4.00457156452852*^9, 
  4.0045715658440485`*^9}},ExpressionUUID->"06732d70-d3dd-46d0-a605-\
6b554176abd3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "CONSTRUCT", " ", "THE", " ", "COMMON", " ", "ENSEMBLE", " ", "KDE"}], 
   "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Combine", " ", "all", " ", "orbital", " ", "energies"}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"allEnergies", "=", 
     RowBox[{"Flatten", "[", "spectra", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Total pooled energies: \>\"", ",", 
      RowBox[{"Length", "[", "allEnergies", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Construct", " ", "ONE", " ", "KDE", " ", "from", " ", "the", " ", 
     "entire", " ", "ensemble"}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"commonKDE", "=", 
     RowBox[{"Quiet", "@", 
      RowBox[{"Check", "[", 
       RowBox[{
        RowBox[{"SmoothKernelDistribution", "[", 
         RowBox[{"allEnergies", ",", "kdeBandwidth"}], "]"}], ",", 
        "$Failed"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"commonKDE", "===", "$Failed"}], ",", 
      RowBox[{
       RowBox[{"Print", "[", "\"\<KDE construction failed.\>\"", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Calculate", " ", "the", " ", "common", " ", "cumulative", " ", 
     "density"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"commonCDFValues", "=", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"CDF", "[", 
         RowBox[{"commonKDE", ",", "#"}], "]"}], "&"}], "/@", "allEnergies"}],
       "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"VectorQ", "[", 
        RowBox[{"commonCDFValues", ",", "NumericQ"}], "]"}]}], ",", 
      RowBox[{
       RowBox[{
       "Print", "[", "\"\<Error in evaluating the common KDE CDF.\>\"", "]"}],
        ";", "\[IndentingNewLine]", 
       RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{4.004229179940987*^9, 4.0042292019371614`*^9}, {
  4.0045715511321106`*^9, 
  4.004571555160367*^9}},ExpressionUUID->"e0790dbd-56cd-40b4-85d3-\
cd70a7d2458b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "UNFOLD", " ", "EACH", " ", "GEOMETRY", " ", "USING", " ", "THE", " ", 
    "SAME", " ", "KDE"}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Multiply", " ", "the", " ", "common", " ", "CDF", " ", "by", " ", "the", 
     " ", "number", " ", "of", " ", "orbitals", " ", "per", " ", "geometry"}],
     ",", 
    RowBox[{
    "NOT", " ", "the", " ", "total", " ", "number", " ", "of", " ", "pooled", 
     " ", "energies"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"unfoldedFlat", "=", 
     RowBox[{"nLevels", " ", "commonCDFValues"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Restore", " ", "the", " ", "original", " ", "geometry", " ", 
     "boundaries"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"unfoldedSpectra", "=", 
     RowBox[{"Partition", "[", 
      RowBox[{"unfoldedFlat", ",", "nLevels"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Sort", " ", "individual", " ", "unfolded", " ", "spectra"}], 
    "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"unfoldedSpectra", "=", 
     RowBox[{"Sort", "/@", "unfoldedSpectra"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Common ensemble KDE unfolding completed.\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Number of unfolded spectra: \>\"", ",", 
      RowBox[{"Length", "[", "unfoldedSpectra", "]"}]}], "]"}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{4.004229222293745*^9, 4.0042292332256527`*^9}, {
  4.004571570701714*^9, 
  4.004571575668059*^9}},ExpressionUUID->"a03f493d-7f49-4bbc-bc7f-\
497c30c19538"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "CALCULATE", " ", "NUMBER", " ", "VARIANCE", " ", "FOR", " ", "THE", " ", 
    "ENSEMBLE"}], "*)"}], "\[IndentingNewLine]", "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"Print", "[", "\"\<Calculating number variance...\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"commonKDEResults", "=", 
     RowBox[{"numberVarianceEnsemble", "[", 
      RowBox[{
      "unfoldedSpectra", ",", "Lvalues", ",", "nStarts", ",", "edgeTrim"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Extract", " ", "results"}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"commonKDEMean", "=", 
     RowBox[{"commonKDEResults", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"commonKDESE", "=", 
     RowBox[{"commonKDEResults", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "3"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nContributing", "=", 
     RowBox[{"commonKDEResults", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "4"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Number variance calculation completed.\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Minimum contributing geometries: \>\"", ",", 
      RowBox[{"Min", "[", "nContributing", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Maximum contributing geometries: \>\"", ",", 
      RowBox[{"Max", "[", "nContributing", "]"}]}], "]"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{4.0045715863080606`*^9, 
  4.004571597234598*^9}},ExpressionUUID->"936a6c88-e553-4b76-ae84-\
ff6c4ade633d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"THEORETICAL", " ", "NUMBER", " ", "VARIANCE", " ", "CURVES"}], 
   "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Generate", " ", "theoretical", " ", "curves"}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"poissonCurve", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"L", ",", 
         RowBox[{"sigmaPoisson", "[", "L", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"L", ",", "Lvalues"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"semiPoissonCurve", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"L", ",", 
         RowBox[{"sigmaSemiPoisson", "[", "L", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"L", ",", "Lvalues"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"GOECurve", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"L", ",", 
         RowBox[{"sigmaGOE", "[", "L", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"L", ",", "Lvalues"}], "}"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Empirical", " ", "KDE", " ", "curve"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"empiricalCurve", "=", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"commonKDEResults", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "]"}], ",", 
       RowBox[{
        RowBox[{"NumericQ", "[", 
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "]"}], "&"}]}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{4.004229307443201*^9, 4.0042293413153048`*^9}, {
