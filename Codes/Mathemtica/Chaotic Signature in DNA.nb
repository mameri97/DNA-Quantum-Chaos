Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"readSpectrum", "[", "file_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"data", ",", "rows", ",", "selectedRows", ",", "energies"}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{"data", "=", 
       RowBox[{"Quiet", "@", 
        RowBox[{"Check", "[", 
         RowBox[{
          RowBox[{"Import", "[", 
           RowBox[{"file", ",", "\"\<CSV\>\""}], "]"}], ",", "$Failed"}], 
         "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"data", "===", "$Failed"}], "||", 
         RowBox[{"!", 
          RowBox[{"ListQ", "[", "data", "]"}]}], "||", 
         RowBox[{
          RowBox[{"Length", "[", "data", "]"}], "<", "2"}]}], ",", 
        RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Remove", " ", "header", " ", "and", " ", "select", " ", "valid", " ", 
        "rows"}], "*)"}], 
      RowBox[{"rows", "=", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"Rest", "[", "data", "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"ListQ", "[", "#", "]"}], "&&", 
           RowBox[{
            RowBox[{"Length", "[", "#", "]"}], "\[GreaterEqual]", "5"}], "&&", 
           RowBox[{"NumericQ", "[", 
            RowBox[{"#", "[", 
             RowBox[{"[", "5", "]"}], "]"}], "]"}], "&&", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"orbitalSelection", "===", "\"\<All\>\""}], "||", 
             RowBox[{"NumericQ", "[", 
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ")"}]}], "&"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Select", " ", "occupied"}], ",", "virtual", ",", 
        RowBox[{"or", " ", "all", " ", "orbitals"}]}], "*)"}], 
      RowBox[{"selectedRows", "=", 
       RowBox[{"Switch", "[", 
        RowBox[{
        "orbitalSelection", ",", "\"\<All\>\"", ",", "rows", ",", 
         "\"\<Occupied\>\"", ",", 
         RowBox[{"Select", "[", 
          RowBox[{"rows", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ">", "0"}], "&"}]}], "]"}], 
         ",", "\"\<Virtual\>\"", ",", 
         RowBox[{"Select", "[", 
          RowBox[{"rows", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "\[Equal]", "0"}], "&"}]}], 
          "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"selectedRows", "===", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Extract", " ", "orbital", " ", "energies", " ", "in", " ", 
        RowBox[{"eV", ":", 
         RowBox[{"column", " ", "5"}]}]}], "*)"}], 
      RowBox[{"energies", "=", 
       RowBox[{"N", "[", 
        RowBox[{"selectedRows", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "5"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"VectorQ", "[", 
          RowBox[{"energies", ",", "NumericQ"}], "]"}]}], ",", 
        RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"VectorQ", "[", 
          RowBox[{"energies", ",", 
           RowBox[{
            RowBox[{"TrueQ", "[", 
             RowBox[{
              RowBox[{"Im", "[", "#", "]"}], "\[Equal]", "0"}], "]"}], 
            "&"}]}], "]"}]}], ",", 
        RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Sort", "[", 
       RowBox[{"Re", "[", "energies", "]"}], "]"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[1458]:=",ExpressionUUID->"5a160f3a-c2e3-4bc8-a6b1-ffd16695cb65"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"IMPORT", " ", "ALL", " ", "SPECTRA"}], "*)"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"rawSpectra", "=", 
     RowBox[{"readSpectrum", "/@", "files"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"validMask", "=", 
     RowBox[{"ListQ", "/@", "rawSpectra"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"spectra", "=", 
     RowBox[{"Pick", "[", 
      RowBox[{"rawSpectra", ",", "validMask"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"validFiles", "=", 
     RowBox[{"Pick", "[", 
      RowBox[{"files", ",", "validMask"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Valid spectra: \>\"", ",", 
      RowBox[{"Length", "[", "spectra", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Invalid files: \>\"", ",", 
      RowBox[{
       RowBox[{"Length", "[", "files", "]"}], "-", 
       RowBox[{"Length", "[", "spectra", "]"}]}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"spectra", "===", 
       RowBox[{"{", "}"}]}], ",", 
      RowBox[{
       RowBox[{"Print", "[", "\"\<No valid spectra found.\>\"", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"CHECK", " ", "ORBITAL", " ", "COUNTS"}], "*)"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"spectrumLengths", "=", 
     RowBox[{"Length", "/@", "spectra"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Orbital counts: \>\"", ",", 
      RowBox[{"Tally", "[", "spectrumLengths", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", 
        RowBox[{"DeleteDuplicates", "[", "spectrumLengths", "]"}], "]"}], 
       "\[NotEqual]", "1"}], ",", 
      RowBox[{
       RowBox[{
       "Print", "[", 
        "\"\<Error: Different numbers of orbitals per geometry.\>\"", "]"}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nLevels", "=", 
     RowBox[{"First", "[", "spectrumLengths", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"nLevels", "<", "minLevels"}], ",", 
      RowBox[{
       RowBox[{
       "Print", "[", "\"\<Insufficient number of orbitals.\>\"", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Orbitals per geometry: \>\"", ",", "nLevels"}], "]"}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{4.004229135906105*^9, 4.004229146726015*^9}, 
   4.0045710187102685`*^9},ExpressionUUID->"0b1c1e58-a719-4be7-924e-\
cafe8175ef93"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Combine", " ", "all", " ", "orbital", " ", "energies"}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"allEnergies", "=", 
     RowBox[{"Flatten", "[", "spectra", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Total pooled energies: \>\"", ",", 
      RowBox[{"Length", "[", "allEnergies", "]"}]}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Construct", " ", "ONE", " ", "KDE", " ", "from", " ", "the", " ", 
     "entire", " ", "ensemble"}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"commonKDE", "=", 
     RowBox[{"Quiet", "@", 
      RowBox[{"Check", "[", 
       RowBox[{
        RowBox[{"SmoothKernelDistribution", "[", 
         RowBox[{"allEnergies", ",", "kdeBandwidth"}], "]"}], ",", 
        "$Failed"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"commonKDE", "===", "$Failed"}], ",", 
      RowBox[{
       RowBox[{"Print", "[", "\"\<KDE construction failed.\>\"", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Calculate", " ", "the", " ", "common", " ", "cumulative", " ", 
     "density"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"commonCDFValues", "=", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"CDF", "[", 
         RowBox[{"commonKDE", ",", "#"}], "]"}], "&"}], "/@", "allEnergies"}],
       "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"VectorQ", "[", 
        RowBox[{"commonCDFValues", ",", "NumericQ"}], "]"}]}], ",", 
      RowBox[{
       RowBox[{
       "Print", "[", "\"\<Error in evaluating the common KDE CDF.\>\"", "]"}],
        ";", "\[IndentingNewLine]", 
       RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{4.004229179940987*^9, 4.0042292019371614`*^9}, {
  4.004570855298951*^9, 
  4.0045708615140915`*^9}},ExpressionUUID->"cecbd624-9a5d-4c89-9744-\
2120f7f21a0d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "  ", 
   RowBox[{
   "UNFOLD", " ", "EACH", " ", "GEOMETRY", " ", "USING", " ", "THE", " ", 
    "SAME", " ", "KDE"}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Multiply", " ", "the", " ", "common", " ", "CDF", " ", "by", " ", "the", 
     " ", "number", " ", "of", " ", "orbitals", " ", "per", " ", "geometry"}],
     ",", 
    RowBox[{
    "NOT", " ", "the", " ", "total", " ", "number", " ", "of", " ", "pooled", 
     " ", "energies"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"unfoldedFlat", "=", 
     RowBox[{"nLevels", " ", "commonCDFValues"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Restore", " ", "the", " ", "original", " ", "geometry", " ", 
     "boundaries"}], " ", "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"unfoldedSpectra", "=", 
     RowBox[{"Partition", "[", 
      RowBox[{"unfoldedFlat", ",", "nLevels"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Sort", " ", "individual", " ", "unfolded", " ", "spectra"}], " ",
     "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"unfoldedSpectra", "=", 
     RowBox[{"Sort", "/@", "unfoldedSpectra"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Common ensemble KDE unfolding completed.\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Number of unfolded spectra: \>\"", ",", 
      RowBox[{"Length", "[", "unfoldedSpectra", "]"}]}], "]"}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{4.004229222293745*^9, 4.0042292332256527`*^9}, {
  4.0045708700285735`*^9, 4.004570870316575*^9}, {4.004570991935385*^9, 
  4.004570994581408*^9}, {4.004571024806904*^9, 
  4.0045710285800753`*^9}},ExpressionUUID->"0dae9d4a-c619-4702-96b5-\
df55753f355a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "CALCULATE", " ", "NUMBER", " ", "VARIANCE", " ", "FOR", " ", "THE", " ", 
    "ENSEMBLE"}], " ", "*)"}], "\[IndentingNewLine]", "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"Print", "[", "\"\<Calculating number variance...\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"commonKDEResults", "=", 
     RowBox[{"numberVarianceEnsemble", "[", 
      RowBox[{
      "unfoldedSpectra", ",", "Lvalues", ",", "nStarts", ",", "edgeTrim"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Extract", " ", "results"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"commonKDEMean", "=", 
     RowBox[{"commonKDEResults", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
