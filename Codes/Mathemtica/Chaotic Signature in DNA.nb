Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "UNFOLD", " ", "EACH", " ", "GEOMETRY", " ", "USING", " ", "THE", " ", 
    "SAME", " ", "KDE"}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Multiply", " ", "the", " ", "common", " ", "CDF", " ", "by", " ", "the", 
     " ", "number", " ", "of", " ", "orbitals", " ", "per", " ", "geometry"}],
     ",", 
    RowBox[{
    "NOT", " ", "the", " ", "total", " ", "number", " ", "of", " ", "pooled", 
     " ", "energies"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"unfoldedFlat", "=", 
     RowBox[{"nLevels", " ", "commonCDFValues"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Restore", " ", "the", " ", "original", " ", "geometry", " ", 
     "boundaries"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"unfoldedSpectra", "=", 
     RowBox[{"Partition", "[", 
      RowBox[{"unfoldedFlat", ",", "nLevels"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Sort", " ", "individual", " ", "unfolded", " ", "spectra"}], 
    "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"unfoldedSpectra", "=", 
     RowBox[{"Sort", "/@", "unfoldedSpectra"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Common ensemble KDE unfolding completed.\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Number of unfolded spectra: \>\"", ",", 
      RowBox[{"Length", "[", "unfoldedSpectra", "]"}]}], "]"}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{4.004229222293745*^9, 4.0042292332256527`*^9}, {
  4.0045716676250734`*^9, 
  4.0045716717415733`*^9}},ExpressionUUID->"88af70fa-3b67-4955-978f-\
d71e073802bd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "CALCULATE", " ", "NUMBER", " ", "VARIANCE", " ", "FOR", " ", "THE", " ", 
    "ENSEMBLE"}], "*)"}], "\[IndentingNewLine]", "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"Print", "[", "\"\<Calculating number variance...\>\"", "]"}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"commonKDEResults", "=", 
     RowBox[{"numberVarianceEnsemble", "[", 
      RowBox[{
      "unfoldedSpectra", ",", "Lvalues", ",", "nStarts", ",", "edgeTrim"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Extract", " ", "results"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"commonKDEMean", "=", 
     RowBox[{"commonKDEResults", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"commonKDESE", "=", 
     RowBox[{"commonKDEResults", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "3"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nContributing", "=", 
     RowBox[{"commonKDEResults", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "4"}], "]"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Number variance calculation completed.\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Minimum contributing geometries: \>\"", ",", 
      RowBox[{"Min", "[", "nContributing", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Maximum contributing geometries: \>\"", ",", 
      RowBox[{"Max", "[", "nContributing", "]"}]}], "]"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{4.0045716917362022`*^9, 4.004571705305256*^9}, 
   4.0045719327459593`*^9},ExpressionUUID->"c31dd203-2c23-4205-8352-\
b46f37d2193f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"THEORETICAL", " ", "NUMBER", " ", "VARIANCE", " ", "CURVES"}], 
   " ", "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Generate", " ", "theoretical", " ", "curves"}], "*)"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"poissonCurve", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"L", ",", 
         RowBox[{"sigmaPoisson", "[", "L", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"L", ",", "Lvalues"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"semiPoissonCurve", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"L", ",", 
         RowBox[{"sigmaSemiPoisson", "[", "L", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"L", ",", "Lvalues"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"GOECurve", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"L", ",", 
         RowBox[{"sigmaGOE", "[", "L", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"L", ",", "Lvalues"}], "}"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Empirical", " ", "KDE", " ", "curve"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"empiricalCurve", "=", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"commonKDEResults", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "]"}], ",", 
       RowBox[{
        RowBox[{"NumericQ", "[", 
         RowBox[{"#", "[", 
