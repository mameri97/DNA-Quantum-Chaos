Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"THEORETICAL", " ", "NUMBER", " ", "VARIANCE", " ", "CURVES"}], 
   " ", "*)"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Generate", " ", "theoretical", " ", "curves"}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"poissonCurve", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"L", ",", 
         RowBox[{"sigmaPoisson", "[", "L", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"L", ",", "Lvalues"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"semiPoissonCurve", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"L", ",", 
         RowBox[{"sigmaSemiPoisson", "[", "L", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"L", ",", "Lvalues"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"GOECurve", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"L", ",", 
