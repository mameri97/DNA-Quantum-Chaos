Cell[CellGroupData[{

Cell[TextData[StyleBox["Tracy-Widom",
 FontWeight->"Bold"]], "Section",
 CellChangeTimes->{{4.00443301248099*^9, 
  4.0044330157049766`*^9}},ExpressionUUID->"fd8abaa1-37ed-4c1c-9a09-\
