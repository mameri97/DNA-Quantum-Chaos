Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"SELECT", " ", "THE", " ", 
    RowBox[{"DATASET", ":", " ", 
     RowBox[{"AT", " ", "OR", " ", "GC"}]}]}], " ", "*)"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"filePaths", "=", 
     RowBox[{"FileNames", "[", 
      RowBox[{
      "\"\<multimode_sample_*.csv\>\"", ",", 
       "\"\<Copy your directory address here\>\""}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Total files found: \>\"", ",", 
      RowBox[{"Length", "[", "filePaths", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "EXTRACT", " ", "THE", " ", "ORIGINAL", " ", "ORBITAL", " ", "ENERGIES"}],
     "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"spectra", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"data", ",", "energies"}], "}"}], ",", 
         RowBox[{
          RowBox[{"data", "=", 
           RowBox[{"Import", "[", 
            RowBox[{"file", ",", "\"\<CSV\>\""}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"energies", "=", 
           RowBox[{"Cases", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Rest", "[", "data", "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "5"}], "]"}], "]"}], ",", 
             RowBox[{"_", "?", "NumericQ"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "energies", "]"}], ">", "0"}], ",", 
            "energies", ",", "$Failed"}], "]"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"file", ",", "filePaths"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"REMOVE", " ", "INVALID", " ", "FILES"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"validSpectra", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"spectra", ",", "ListQ"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Valid spectra: \>\"", ",", 
      RowBox[{"Length", "[", "validSpectra", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"EXTRACT", " ", "EXTREME", " ", "EIGENVALUES"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"maxEigenvalues", "=", 
     RowBox[{"Max", "/@", "validSpectra"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"minEigenvalues", "=", 
     RowBox[{"Min", "/@", "validSpectra"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Number of maximum eigenvalues: \>\"", ",", 
      RowBox[{"Length", "[", "maxEigenvalues", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Number of minimum eigenvalues: \>\"", ",", 
      RowBox[{"Length", "[", "minEigenvalues", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"BASIC", " ", "STATISTICS"}], "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Maximum eigenvalue range (eV): \>\"", ",", 
      RowBox[{"MinMax", "[", "maxEigenvalues", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Minimum eigenvalue range (eV): \>\"", ",", 
      RowBox[{"MinMax", "[", "minEigenvalues", "]"}]}], "]"}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{4.004433024132688*^9, 4.004433027571906*^9}, {
  4.004494029455182*^9, 4.0044940298877068`*^9}, {4.0045687820332546`*^9, 
  4.00456878947773*^9}, {4.004568837414623*^9, 
  4.004568900603917*^9}},ExpressionUUID->"febaca09-6194-45b0-8236-\
fce34c20acba"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"SELECT", " ", "TRACY"}], "-", 
    RowBox[{"WIDOM", " ", "DISTRIBUTION"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"beta", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"twDist", "=", 
     RowBox[{"TracyWidomDistribution", "[", "beta", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "THEORETICAL", " ", "MEAN", " ", "AND", " ", "STANDARD", " ", 
     "DEVIATION"}], "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"twMean", "=", 
     RowBox[{"N", "[", 
      RowBox[{"Mean", "[", "twDist", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"twSD", "=", 
     RowBox[{"N", "[", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"Variance", "[", "twDist", "]"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<TW mean: \>\"", ",", "twMean"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<TW standard deviation: \>\"", ",", "twSD"}], "]"}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{4.0044330448687*^9, 4.004433046443158*^9}, {
  4.0044940518620415`*^9, 4.0044940580639124`*^9}, {4.004568796403631*^9, 
  4.0045688024208984`*^9}},ExpressionUUID->"971b1f3a-cf7b-4b49-8194-\
85147a3240e1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"zMax", "=", 
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"maxEigenvalues", "-", 
       RowBox[{"Mean", "[", "maxEigenvalues", "]"}]}], ")"}], "/", 
     RowBox[{"StandardDeviation", "[", "maxEigenvalues", "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"reflectedMin", "=", 
   RowBox[{"-", "minEigenvalues"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"zMin", "=", 
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"reflectedMin", "-", 
       RowBox[{"Mean", "[", "reflectedMin", "]"}]}], ")"}], "/", 
     RowBox[{"StandardDeviation", "[", "reflectedMin", "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"twStandardizedPDF", "[", "x_", "]"}], ":=", 
   RowBox[{"twSD", " ", 
    RowBox[{"PDF", "[", 
     RowBox[{"twDist", ",", 
      RowBox[{"twMean", "+", 
       RowBox[{"twSD", " ", "x"}]}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"twStandardizedCDF", "[", "x_", "]"}], ":=", 
   RowBox[{"CDF", "[", 
    RowBox[{"twDist", ",", 
     RowBox[{"twMean", "+", 
      RowBox[{"twSD", " ", "x"}]}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{4.0044330529760365`*^9, 4.0044330643935776`*^9}, {
  4.0044940788707423`*^9, 4.004494101201173*^9}, {4.0045688091622777`*^9, 
  4.004568812845422*^9}},ExpressionUUID->"5caefc2e-af32-4f42-8d67-\
bf8308ec6d8b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Maximum", " ", "EIGENVALUES"}], " ", "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"maxPlot", "=", 
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"Histogram", "[", 
        RowBox[{"zMax", ",", 
         RowBox[{"{", "0.25", "}"}], ",", "\"\<PDF\>\""}], "]"}], ",", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"twStandardizedPDF", "[", "x", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{
            RowBox[{"Min", "[", "zMax", "]"}], "-", "0.5"}], ",", 
           RowBox[{
            RowBox[{"Max", "[", "zMax", "]"}], "+", "0.5"}]}], "}"}], ",", 
         RowBox[{"PlotStyle", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"Red", ",", "Thick"}], "}"}]}]}], "]"}], ",", 
       RowBox[{
       "PlotLabel", "\[Rule]", "\"\<Maximum Eigenvalue Distribution\>\""}], 
       ",", 
       RowBox[{"Frame", "\[Rule]", "True"}], ",", 
       RowBox[{"FrameLabel", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
         "\"\<Standardized maximum eigenvalue\>\"", ",", 
          "\"\<Probability density\>\""}], "}"}]}], ",", 
       RowBox[{"PlotLegends", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<Numerical data\>\"", ",", "\"\<Tracy-Widom\>\""}], 
         "}"}]}], ",", 
       RowBox[{"ImageSize", "\[Rule]", "Large"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"MINIMUM", " ", "EIGENVALUES"}], " ", "*)"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"minPlot", "=", 
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"Histogram", "[", 
        RowBox[{"zMin", ",", 
         RowBox[{"{", "0.25", "}"}], ",", "\"\<PDF\>\""}], "]"}], ",", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"twStandardizedPDF", "[", "x", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{
            RowBox[{"Min", "[", "zMin", "]"}], "-", "0.5"}], ",", 
           RowBox[{
            RowBox[{"Max", "[", "zMin", "]"}], "+", "0.5"}]}], "}"}], ",", 
         RowBox[{"PlotStyle", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"Red", ",", "Thick"}], "}"}]}]}], "]"}], ",", 
       RowBox[{
       "PlotLabel", "\[Rule]", "\"\<Minimum Eigenvalue Distribution\>\""}], 
       ",", 
       RowBox[{"Frame", "\[Rule]", "True"}], ",", 
       RowBox[{"FrameLabel", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
         "\"\<Standardized reflected minimum eigenvalue\>\"", ",", 
          "\"\<Probability density\>\""}], "}"}]}], ",", 
       RowBox[{"PlotLegends", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<Numerical data\>\"", ",", "\"\<Tracy-Widom\>\""}], 
         "}"}]}], ",", 
       RowBox[{"ImageSize", "\[Rule]", "Large"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", "maxPlot", "\n", "minPlot", "\n"}]}]], "Input",
 CellChangeTimes->{{4.004433103085438*^9, 4.004433148429329*^9}, {
