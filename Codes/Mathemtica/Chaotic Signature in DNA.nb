Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"CUMULATIVE", " ", "DISTRIBUTION", " ", "COMPARISON"}], " ", 
   "*)"}], "\[IndentingNewLine]", "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"empiricalCDF", "[", "data_List", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"sorted", ",", "n"}], "}"}], ",", 
       RowBox[{
        RowBox[{"sorted", "=", 
         RowBox[{"Sort", "[", "data", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"n", "=", 
         RowBox[{"Length", "[", "sorted", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Interpolation", "[", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"First", "[", "sorted", "]"}], "-", 
                RowBox[{"10", "^", 
                 RowBox[{"-", "8"}]}]}], ",", "0"}], "}"}], "}"}], ",", 
            RowBox[{"Transpose", "[", 
             RowBox[{"{", 
              RowBox[{"sorted", ",", 
               RowBox[{
                RowBox[{"Range", "[", "n", "]"}], "/", "n"}]}], "}"}], 
             "]"}]}], "]"}], ",", 
          RowBox[{"InterpolationOrder", "\[Rule]", "0"}]}], "]"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"MAXIMUM", " ", "EIGENVALUES"}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"maxEmpCDF", "=", 
     RowBox[{"empiricalCDF", "[", "zMax", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"maxCDFPlot", "=", 
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"maxEmpCDF", "[", "x", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{
            RowBox[{"Min", "[", "zMax", "]"}], "-", "0.5"}], ",", 
           RowBox[{
            RowBox[{"Max", "[", "zMax", "]"}], "+", "0.5"}]}], "}"}], ",", 
         RowBox[{"PlotStyle", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"Blue", ",", "Thick"}], "}"}]}]}], "]"}], ",", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"twStandardizedCDF", "[", "x", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{
            RowBox[{"Min", "[", "zMax", "]"}], "-", "0.5"}], ",", 
           RowBox[{
            RowBox[{"Max", "[", "zMax", "]"}], "+", "0.5"}]}], "}"}], ",", 
         RowBox[{"PlotStyle", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"Red", ",", "Thick"}], "}"}]}]}], "]"}], ",", 
       RowBox[{"PlotLabel", "\[Rule]", "\"\<Maximum Eigenvalue: CDF\>\""}], 
       ",", 
       RowBox[{"Frame", "\[Rule]", "True"}], ",", 
       RowBox[{"FrameLabel", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
         "\"\<Standardized eigenvalue\>\"", ",", 
          "\"\<Cumulative probability\>\""}], "}"}]}], ",", 
       RowBox[{"PlotLegends", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<Numerical data\>\"", ",", "\"\<Tracy-Widom\>\""}], 
         "}"}]}], ",", 
       RowBox[{"ImageSize", "\[Rule]", "Large"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"MINIMUM", " ", "EIGENVALUES"}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"minEmpCDF", "=", 
     RowBox[{"empiricalCDF", "[", "zMin", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"minCDFPlot", "=", 
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"minEmpCDF", "[", "x", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{
            RowBox[{"Min", "[", "zMin", "]"}], "-", "0.5"}], ",", 
           RowBox[{
            RowBox[{"Max", "[", "zMin", "]"}], "+", "0.5"}]}], "}"}], ",", 
         RowBox[{"PlotStyle", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"Blue", ",", "Thick"}], "}"}]}]}], "]"}], ",", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"twStandardizedCDF", "[", "x", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{
            RowBox[{"Min", "[", "zMin", "]"}], "-", "0.5"}], ",", 
           RowBox[{
            RowBox[{"Max", "[", "zMin", "]"}], "+", "0.5"}]}], "}"}], ",", 
         RowBox[{"PlotStyle", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"Red", ",", "Thick"}], "}"}]}]}], "]"}], ",", 
       RowBox[{"PlotLabel", "\[Rule]", "\"\<Minimum Eigenvalue: CDF\>\""}], 
       ",", 
       RowBox[{"Frame", "\[Rule]", "True"}], ",", 
       RowBox[{"FrameLabel", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
         "\"\<Standardized reflected eigenvalue\>\"", ",", 
          "\"\<Cumulative probability\>\""}], "}"}]}], ",", 
       RowBox[{"PlotLegends", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<Numerical data\>\"", ",", "\"\<Tracy-Widom\>\""}], 
         "}"}]}], ",", 
       RowBox[{"ImageSize", "\[Rule]", "Large"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", "maxCDFPlot", "\n", "minCDFPlot", 
   "\n"}]}]], "Input",
 CellChangeTimes->{{4.004433234885296*^9, 4.004433234888294*^9}, {
