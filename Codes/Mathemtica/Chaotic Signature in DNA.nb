Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"DEFINE", " ", "UNFOLDING"}], "&"}], " ", "NORMALIZATION", " ", 
    "FUNCTION", " ", "FOR", " ", "A", " ", "SINGLE", " ", "FILE"}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ProcessSingleFile", "[", "filePath_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "importedData", ",", "rawEnergies", ",", "sortedLevels", ",", "nTotal", 
       ",", "trimCount", ",", "coreLevels", ",", "nCore", ",", "kdeDist", ",",
        "unfoldedLevels", ",", "spacings", ",", "meanS", ",", 
       "normSpacings"}], "}"}], ",", 
     RowBox[{
      RowBox[{"importedData", "=", 
       RowBox[{"Import", "[", 
        RowBox[{"filePath", ",", "\"\<Data\>\""}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "importedData", "]"}], "\[LessEqual]", "1"}], 
        ",", 
        RowBox[{"Return", "[", 
         RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Extract", " ", "energy", " ", "column"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"rawEnergies", "=", 
       RowBox[{"ToExpression", "[", 
        RowBox[{
         RowBox[{"Rest", "[", "importedData", "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "5"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"sortedLevels", "=", 
       RowBox[{"Sort", "[", 
        RowBox[{"N", "[", 
         RowBox[{"DeleteCases", "[", 
          RowBox[{"rawEnergies", ",", 
           RowBox[{
           "_Missing", "|", "Null", "|", "\"\<\>\"", "|", "_String"}]}], 
          "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"nTotal", "=", 
       RowBox[{"Length", "[", "sortedLevels", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"nTotal", "<", "20"}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Band", "-", 
        RowBox[{"edge", " ", "trimming", " ", 
         RowBox[{"(", 
          RowBox[{"outer", " ", "10", "%"}], ")"}]}]}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"trimCount", "=", 
       RowBox[{"Floor", "[", 
        RowBox[{"0.1", "*", "nTotal"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"coreLevels", "=", 
       RowBox[{"Take", "[", 
        RowBox[{"sortedLevels", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"trimCount", "+", "1"}], ",", 
           RowBox[{"nTotal", "-", "trimCount"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"nCore", "=", 
       RowBox[{"Length", "[", "coreLevels", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"nCore", "<", "10"}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Gaussian", " ", "KDE", " ", "Unfolding"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"kdeDist", "=", 
       RowBox[{"SmoothKernelDistribution", "[", "coreLevels", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"unfoldedLevels", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"nCore", "*", 
          RowBox[{"CDF", "[", 
           RowBox[{"kdeDist", ",", "e"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"e", ",", "coreLevels"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"Spacings", "&"}], " ", "Local", " ", "Normalization"}], " ", 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"spacings", "=", 
       RowBox[{"Differences", "[", "unfoldedLevels", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "spacings", "]"}], "\[Equal]", "0"}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"meanS", "=", 
       RowBox[{"Mean", "[", "spacings", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"meanS", "\[LessEqual]", "0"}], "||", 
         RowBox[{"!", 
          RowBox[{"NumberQ", "[", "meanS", "]"}]}]}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"normSpacings", "=", 
       RowBox[{"spacings", "/", "meanS"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Filter", " ", "strictly", " ", "within", " ", "plot", " ", "range", 
        " ", "boundary"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Select", "[", 
       RowBox[{"normSpacings", ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"#", ">", "0"}], ")"}], "&"}]}], "]"}]}]}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{4.0031966914009333`*^9, 4.003196783084219*^9}, 
   4.003196886460707*^9, 4.003205211680318*^9, 4.0032054202208652`*^9, 
   4.0032055492574697`*^9, {4.0040843156823215`*^9, 4.0040843170879316`*^9}, {
   4.0045694728525133`*^9, 4.0045694733455153`*^9}},
 CellLabel->"In[10]:=",ExpressionUUID->"58265bf3-b605-473f-a23e-a80c5a443bea"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"DEFINE", " ", "FUNCTION", " ", "TO", " ", "COMPUTE", " ", "r"}], 
    "-", 
    RowBox[{"VALUES", " ", "FOR", " ", "A", " ", "SINGLE", " ", "FILE"}]}], 
   "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ProcessSingleFileForR", "[", "filePath_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "importedData", ",", "rawEnergies", ",", "sortedLevels", ",", 
        "rawSpacings", ",", "rValues"}], "}"}], ",", 
      RowBox[{"(*", 
       RowBox[{
       "Import", " ", "CSV", " ", "as", " ", "raw", " ", "Data", " ", 
        "table"}], "*)"}], 
      RowBox[{
       RowBox[{"importedData", "=", 
        RowBox[{"Import", "[", 
         RowBox[{"filePath", ",", "\"\<Data\>\""}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "importedData", "]"}], "\[LessEqual]", "1"}],
          ",", 
         RowBox[{"Return", "[", 
          RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Extract", " ", "column", " ", "4", " ", 
         RowBox[{"(", "\"\<orbital_energy_hartree\>\"", ")"}], " ", "and", 
         " ", "clean"}], "*)"}], 
       RowBox[{"rawEnergies", "=", 
        RowBox[{"ToExpression", "[", 
         RowBox[{
          RowBox[{"Rest", "[", "importedData", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "4"}], "]"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sortedLevels", "=", 
        RowBox[{"Sort", "[", 
         RowBox[{"N", "[", 
          RowBox[{"DeleteCases", "[", 
           RowBox[{"rawEnergies", ",", 
            RowBox[{
            "_Missing", "|", "Null", "|", "\"\<\>\"", "|", "_String"}]}], 
           "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "sortedLevels", "]"}], "<", "10"}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"{", "}"}], "]"}]}], "]"}], ";", 
       RowBox[{"(*", 
        RowBox[{
        "Skip", " ", "files", " ", "with", " ", "too", " ", "few", " ", 
         "levels"}], "*)"}], 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "Compute", " ", "consecutive", " ", "raw", " ", "spacings", " ", 
          "s_i"}], "=", 
         RowBox[{
          RowBox[{"E_", 
           RowBox[{"{", 
            RowBox[{"i", "+", "1"}], "}"}]}], "-", "E_i"}]}], "*)"}], 
       RowBox[{"rawSpacings", "=", 
        RowBox[{"Differences", "[", "sortedLevels", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "rawSpacings", "]"}], "<", "2"}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
          RowBox[{"Compute", " ", "adjacent"}], "-", 
          RowBox[{"gap", " ", "ratios", " ", "r_i"}]}], "=", 
         RowBox[{"Min", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"s_i", ",", 
             RowBox[{"s_", 
              RowBox[{"{", 
               RowBox[{"i", "+", "1"}], "}"}]}]}], ")"}], "/", "Max"}], 
          RowBox[{"(", 
           RowBox[{"s_i", ",", 
            RowBox[{"s_", 
             RowBox[{"{", 
              RowBox[{"i", "+", "1"}], "}"}]}]}], ")"}]}]}], "*)"}], 
       RowBox[{"rValues", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Min", "[", 
            RowBox[{
             RowBox[{"rawSpacings", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", 
             RowBox[{"rawSpacings", "[", 
              RowBox[{"[", 
               RowBox[{"i", "+", "1"}], "]"}], "]"}]}], "]"}], "/", 
           RowBox[{"Max", "[", 
            RowBox[{
             RowBox[{"rawSpacings", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", 
             RowBox[{"rawSpacings", "[", 
              RowBox[{"[", 
               RowBox[{"i", "+", "1"}], "]"}], "]"}]}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{
             RowBox[{"Length", "[", "rawSpacings", "]"}], "-", "1"}]}], 
           "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", "rValues"}]}], 
     "]"}]}], ";"}]}]], "Input",
