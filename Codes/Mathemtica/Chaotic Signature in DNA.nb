Cell[BoxData[{
 RowBox[{
  RowBox[{"folder", "=", 
   RowBox[{"SystemDialogInput", "[", "\"\<Directory\>\"", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"folder", "===", "$Canceled"}], ",", 
    RowBox[{"Abort", "[", "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"files", "=", 
   RowBox[{"Sort", "@", 
    RowBox[{"FileNames", "[", 
     RowBox[{"filePattern", ",", "folder"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Files found: \>\"", ",", 
    RowBox[{"Length", "[", "files", "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"files", "===", 
     RowBox[{"{", "}"}]}], ",", 
    RowBox[{
     RowBox[{
     "Print", "[", 
      "\"\<No CSV files found. Check the folder and file pattern.\>\"", "]"}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"!", 
     RowBox[{"MemberQ", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "\"\<All\>\"", ",", "\"\<Occupied\>\"", ",", "\"\<Virtual\>\""}], 
        "}"}], ",", "orbitalSelection"}], "]"}]}], ",", 
    RowBox[{
     RowBox[{"Print", "[", "\"\<Invalid orbital selection.\>\"", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], ";"}]}], "Input",
 CellLabel->
