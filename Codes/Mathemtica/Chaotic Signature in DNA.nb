Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"KSdistance", "[", 
     RowBox[{"data_List", ",", "theoreticalCDF_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"sorted", ",", "n", ",", "i", ",", "dPlus", ",", "dMinus"}], 
       "}"}], ",", 
      RowBox[{
       RowBox[{"sorted", "=", 
        RowBox[{"Sort", "[", "data", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"n", "=", 
        RowBox[{"Length", "[", "sorted", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"dPlus", "=", 
        RowBox[{"Max", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"i", "/", "n"}], "-", 
            RowBox[{"theoreticalCDF", "[", 
             RowBox[{"sorted", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "n"}], "}"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"dMinus", "=", 
        RowBox[{"Max", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"theoreticalCDF", "[", 
             RowBox[{"sorted", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "]"}], "-", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"i", "-", "1"}], ")"}], "/", "n"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "n"}], "}"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Max", "[", 
        RowBox[{"dPlus", ",", "dMinus"}], "]"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"maxKS", "=", 
    RowBox[{"KSdistance", "[", 
     RowBox[{"zMax", ",", "twStandardizedCDF"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"minKS", "=", 
    RowBox[{"KSdistance", "[", 
     RowBox[{"zMin", ",", "twStandardizedCDF"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Maximum eigenvalue KS distance: \>\"", ",", "maxKS"}], "]"}],
    ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Minimum eigenvalue KS distance: \>\"", ",", "minKS"}], "]"}], 
  ";"}], "\n"}], "Input",
 CellChangeTimes->{{4.0044332601821737`*^9, 4.0044332601871743`*^9}, {
