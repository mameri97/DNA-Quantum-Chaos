      ",", 
     RowBox[{"{", 
      RowBox[{"\"\<GOE\>\"", ",", 
       RowBox[{"NumberForm", "[", 
        RowBox[{"GOEDeviation", ",", 
         RowBox[{"{", 
          RowBox[{"8", ",", "4"}], "}"}]}], "]"}]}], "}"}], ",", 
