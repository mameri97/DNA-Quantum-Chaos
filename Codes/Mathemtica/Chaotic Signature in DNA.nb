Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"AT", " ", "DIRECTORY"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"atFolder", "=", "\"\<AT-HB Directory\>\""}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"GC", " ", "DIRECTORY"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"gcFolder", "=", "\"\<GC-HB Directory\>\""}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"CSV", " ", "FILE", " ", "PATTERN"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"filePattern", "=", "\"\<frame_*.csv\>\""}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "FIND", " ", "FILES", " ", "IN", " ", "EACH", " ", "DIRECTORY", " ", 
     "INDEPENDENTLY"}], "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"atFiles", "=", 
     RowBox[{"Sort", "@", 
      RowBox[{"FileNames", "[", 
       RowBox[{"filePattern", ",", "atFolder"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gcFiles", "=", 
     RowBox[{"Sort", "@", 
      RowBox[{"FileNames", "[", 
       RowBox[{"filePattern", ",", "gcFolder"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"COMBINE", " ", "THE", " ", "TWO", " ", "FILE", " ", "LISTS"}], 
    "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"files", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"atFiles", ",", "gcFiles"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<AT files: \>\"", ",", 
      RowBox[{"Length", "[", "atFiles", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<GC files: \>\"", ",", 
      RowBox[{"Length", "[", "gcFiles", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Total files: \>\"", ",", 
      RowBox[{"Length", "[", "files", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"files", "===", 
       RowBox[{"{", "}"}]}], ",", 
      RowBox[{"Abort", "[", "]"}]}], "]"}], ";"}]}]}]], "Input",
