Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"EXTRACT", " ", "ALL", " ", "ORBITAL", " ", "ENERGIES"}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"allEnergies", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"data", "=", 
          RowBox[{"Import", "[", 
           RowBox[{"file", ",", "\"\<CSV\>\""}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Rest", "[", "data", "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "5"}], "]"}], "]"}], ",", "NumericQ"}], 
          "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"file", ",", "GCHBfilePaths"}], "}"}]}], "]"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"CALCULATE", " ", "MINIMUM", " ", "AND", " ", "MAXIMUM"}], "*)"}],
    "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Total orbital energies: \>\"", ",", 
      RowBox[{"Length", "[", "allEnergies", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Minimum orbital energy (eV): \>\"", ",", 
      RowBox[{"Min", "[", "allEnergies", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Maximum orbital energy (eV): \>\"", ",", 
      RowBox[{"Max", "[", "allEnergies", "]"}]}], "]"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{4.004083632655281*^9, 4.0040836564371157`*^9}, {
  4.004083885814067*^9, 4.0040838860420666`*^9}, {4.0045693040821066`*^9, 
