Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"COMBINED", " ", "AT"}], "+", 
    RowBox[{"GC", " ", "NUMBER", " ", "VARIANCE"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Lvalues", "=", 
     RowBox[{"N", "[", 
      RowBox[{"Range", "[", 
       RowBox[{"0.5", ",", "20", ",", "0.5"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nStarts", "=", "150"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"edgeTrim", "=", "5"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Calculating combined AT + GC number variance...\>\"", 
     "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"combinedResults", "=", 
     RowBox[{"numberVarianceEnsemble", "[", 
      RowBox[{
      "unfoldedSpectra", ",", "Lvalues", ",", "nStarts", ",", "edgeTrim"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"EXTRACT", " ", "RESULTS"}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"combinedMean", "=", 
     RowBox[{"combinedResults", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"combinedSE", "=", 
     RowBox[{"combinedResults", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "3"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nContributing", "=", 
     RowBox[{"combinedResults", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "4"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"EMPIRICAL", " ", "CURVE"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"empiricalCurve", "=", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"combinedResults", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "]"}], ",", 
       RowBox[{
        RowBox[{"NumericQ", "[", 
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "]"}], "&"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Calculation completed.\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Total geometries: \>\"", ",", 
      RowBox[{"Length", "[", "unfoldedSpectra", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Minimum contributing geometries: \>\"", ",", 
      RowBox[{"Min", "[", "nContributing", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Maximum contributing geometries: \>\"", ",", 
      RowBox[{"Max", "[", "nContributing", "]"}]}], "]"}], ";"}]}]}]], "Input",
